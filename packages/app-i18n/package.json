{
  "name": "@codaco/app-i18n",
  "version": "0.1.0",
  "description": "Shared application UI internationalisation for Network Canvas apps: ICU message catalogs, locale negotiation, and React bindings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/complexdatacollective/network-canvas-monorepo.git",
    "directory": "packages/app-i18n"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./messages": "./src/messages.ts",
    "./react": "./src/react.tsx",
    "./negotiate": "./src/negotiate.ts",
    "./locales": "./src/locales.ts",
    "./common": "./src/common.ts",
    "./vite": "./src/vite.ts",
    "./catalog-guards": "./src/catalog-guards.ts"
  },
  "publishConfig": {
    "exports": {
      "./messages": {
        "types": "./dist/messages.d.ts",
        "default": "./dist/messages.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./negotiate": {
        "types": "./dist/negotiate.d.ts",
        "default": "./dist/negotiate.js"
      },
      "./locales": {
        "types": "./dist/locales.d.ts",
        "default": "./dist/locales.js"
      },
      "./common": {
        "types": "./dist/common.d.ts",
        "default": "./dist/common.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./catalog-guards": {
        "types": "./dist/catalog-guards.d.ts",
        "default": "./dist/catalog-guards.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "node scripts/extract-i18n.mjs",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@formatjs/cli-lib": "catalog:",
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@formatjs/intl-localematcher": "catalog:",
    "@formatjs/unplugin": "catalog:",
    "react-intl": "catalog:"
  },
  "devDependencies": {
    "@codaco/tsconfig": "workspace:^",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
