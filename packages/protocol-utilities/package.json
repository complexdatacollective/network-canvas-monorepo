{
  "name": "@codaco/protocol-utilities",
  "version": "4.0.0",
  "description": "Synthetic network generation and interview-payload builder for Network Canvas protocols.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/complexdatacollective/network-canvas-monorepo.git",
    "directory": "packages/protocol-utilities"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./messages": "./src/messages.ts",
    "./locales": "./src/locales/catalogs.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./messages": {
        "types": "./dist/messages.d.ts",
        "import": "./dist/messages.js"
      },
      "./locales": {
        "types": "./dist/locales.d.ts",
        "import": "./dist/locales.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo node_modules dist",
    "i18n:extract": "node scripts/extract-i18n.mjs"
  },
  "dependencies": {
    "@codaco/network-query": "workspace:^",
    "@codaco/protocol-validation": "workspace:^",
    "@codaco/shared-consts": "workspace:^",
    "@faker-js/faker": "catalog:",
    "es-toolkit": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@codaco/app-i18n": "workspace:^",
    "@codaco/fresco-ui": "workspace:^",
    "@codaco/tsconfig": "workspace:^",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@codaco/app-i18n": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@codaco/app-i18n": {
      "optional": true
    }
  }
}
