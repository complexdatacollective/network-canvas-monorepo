{
  "extends": "@codaco/tsconfig/base.json",
  "compilerOptions": {
    // The contract types a staged file as a `Blob`, which every host this
    // package is written for has and neither the base lib nor a bare Node
    // types entry declares.
    "lib": ["dom", "ES2024"],
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
