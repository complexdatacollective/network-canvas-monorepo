{
  "name": "Release Smoke",
  "description": "Purpose-built protocol for the Interviewer release smoke test. Six stages exercise every interview data-model write path (ego, node, layout, two edge-creation paths, categorical attribute) in a walk short enough to conduct entirely offline. Interfaces are imported eagerly in the engine bundle, so broader stage-type coverage belongs to the e2e and Storybook suites, not this gate.",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en-US", "locales": ["en-US"] },
  "lastModified": "2026-08-28T00:00:00.000Z",
  "codebook": {
    "node": {
      "person": {
        "name": "Person",
        "label": { "en-US": "Person" },
        "color": "node-color-seq-1",
        "shape": { "default": "circle" },
        "variables": {
          "name": {
            "name": "name",
            "label": { "en-US": "name" },
            "type": "text",
            "component": "Text",
            "validation": { "required": true }
          },
          "layout": {
            "name": "layout",
            "label": { "en-US": "layout" },
            "type": "layout"
          },
          "context": {
            "name": "context",
            "label": { "en-US": "context" },
            "type": "categorical",
            "options": [
              { "label": { "en-US": "Work" }, "value": "work" },
              { "label": { "en-US": "Social" }, "value": "social" },
              { "label": { "en-US": "Family" }, "value": "family" }
            ]
          }
        }
      }
    },
    "edge": {
      "knows": {
        "name": "Knows",
        "label": { "en-US": "Knows" },
        "color": "edge-color-seq-1"
      },
      "friends": {
        "name": "Friends",
        "label": { "en-US": "Friends" },
        "color": "edge-color-seq-2"
      }
    },
    "ego": {
      "variables": {
        "ego_name": {
          "name": "ego_name",
          "label": { "en-US": "ego_name" },
          "type": "text",
          "component": "Text",
          "validation": { "required": true }
        }
      }
    }
  },
  "stages": [
    {
      "id": "stage-info",
      "type": "Information",
      "label": { "en-US": "Welcome" },
      "title": { "en-US": "Welcome" },
      "items": [
        {
          "id": "item-1",
          "type": "text",
          "content": {
            "en-US": "# Release smoke\n\nThis short interview exercises every data write path."
          }
        }
      ]
    },
    {
      "id": "stage-ego",
      "type": "EgoForm",
      "label": { "en-US": "About you" },
      "introductionPanel": {
        "title": { "en-US": "Introduction" },
        "text": { "en-US": "Tell us about **you**." }
      },
      "form": {
        "fields": [
          {
            "variable": "ego_name",
            "prompt": { "en-US": "What is your name?" }
          }
        ]
      }
    },
    {
      "id": "stage-ng",
      "type": "NameGeneratorQuickAdd",
      "label": { "en-US": "Name people" },
      "subject": { "entity": "node", "type": "person" },
      "quickAdd": "name",
      "behaviours": { "minNodes": 1, "maxNodes": 8 },
      "prompts": [
        { "id": "p1", "text": { "en-US": "Who are the people you know?" } }
      ]
    },
    {
      "id": "stage-socio",
      "type": "Sociogram",
      "label": { "en-US": "Place and connect" },
      "subject": { "entity": "node", "type": "person" },
      "background": { "concentricCircles": 4, "skewedTowardCenter": true },
      "prompts": [
        {
          "id": "p1",
          "text": {
            "en-US": "Drag to place everyone; link people who know each other."
          },
          "layout": { "layoutVariable": "layout" },
          "edges": { "create": "knows", "display": ["knows"] }
        }
      ]
    },
    {
      "id": "stage-dyad",
      "type": "DyadCensus",
      "label": { "en-US": "Friendships" },
      "subject": { "entity": "node", "type": "person" },
      "introductionPanel": {
        "title": { "en-US": "Friendships" },
        "text": {
          "en-US": "You will be asked about each pair of people you named."
        }
      },
      "prompts": [
        {
          "id": "p1",
          "text": { "en-US": "Are these two people friends?" },
          "createEdge": "friends"
        }
      ]
    },
    {
      "id": "stage-catbin",
      "type": "CategoricalBin",
      "label": { "en-US": "Context" },
      "subject": { "entity": "node", "type": "person" },
      "prompts": [
        {
          "id": "p1",
          "text": { "en-US": "How do you know each person?" },
          "variable": "context"
        }
      ]
    }
  ]
}
