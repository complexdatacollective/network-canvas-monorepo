  "stages": [
    {
      "id": "anonymisation-1",
      "type": "Anonymisation",
      "label": { "en-US": "Anonymisation" },
      "explanationText": {
        "title": { "en-US": "This interview uses enhanced privacy protection" },
        "body": {
          "en-US": "This interview allows you to encrypt the names of people you mention so they cannot be seen by anyone but you. To use this feature, enter a passphrase below."
        }
      },
      "validation": {
        "minLength": 4,
        "maxLength": 12
      }
    },
    {
      "id": "ego-form-1",
      "type": "EgoForm",
      "label": { "en-US": "Ego Form" },
      "form": {
        "fields": [
          {
            "variable": "ego_name",
            "prompt": { "en-US": "What is your name?" }
          }
        ]
      },
      "introductionPanel": {
        "title": { "en-US": "Introduction" },
        "text": {
          "en-US": "There are a few questions about you before we begin."
        }
      }
    },
    {
      "id": "information-1",
      "type": "Information",
      "label": { "en-US": "Information" },
      "title": { "en-US": "Welcome" },
      "items": [
        {
          "id": "info-item-1",
          "type": "text",
          "content": { "en-US": "Welcome to this interview." }
        }
      ]
    },
    {
      "id": "name-generator-1",
      "type": "NameGenerator",
      "label": { "en-US": "Name Generator" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "form": {
        "title": { "en-US": "Add a person" },
        "fields": [
          {
            "variable": "name",
            "prompt": { "en-US": "What is this person's name?" }
          }
        ]
      },
      "prompts": [
        {
          "id": "name-generator-prompt-1",
          "text": { "en-US": "Who are the people you know?" }
        }
      ]
    },
    {
      "id": "name-generator-quick-add-1",
      "type": "NameGeneratorQuickAdd",
      "label": { "en-US": "Name Generator Quick Add" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "quickAdd": "name",
      "prompts": [
        {
          "id": "name-generator-quick-add-prompt-1",
          "text": { "en-US": "Quickly add people you know" }
        }
      ]
    },
    {
      "id": "name-generator-roster-1",
      "type": "NameGeneratorRoster",
      "label": { "en-US": "Name Generator Roster" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "dataSource": "roster_data",
      "cardOptions": {
        "additionalProperties": [
          {
            "label": { "en-US": "Age" },
            "variable": "age"
          }
        ]
      },
      "sortOptions": {
        "sortOrder": [
          {
            "property": "age",
            "direction": "desc"
          }
        ],
        "sortableProperties": [
          {
            "label": { "en-US": "Age" },
            "variable": "age"
          }
        ]
      },
      "searchOptions": {
        "fuzziness": 0.4,
        "matchProperties": ["name", "age"]
      },
      "prompts": [
        {
          "id": "name-generator-roster-prompt-1",
          "text": { "en-US": "Select people from the roster" }
        }
      ],
      "behaviours": {
        "minNodes": 1,
        "maxNodes": 8
      }
    },
    {
      "id": "sociogram-1",
      "type": "Sociogram",
      "label": { "en-US": "Sociogram" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "background": {
        "concentricCircles": 4,
        "skewedTowardCenter": true
      },
      "behaviours": {
        "automaticLayout": true
      },
      "prompts": [
        {
          "id": "sociogram-prompt-1",
          "text": {
            "en-US": "Place the people who know each other close together"
          },
          "layout": {
            "layoutVariable": "layout"
          },
          "edges": {
            "display": ["knows"],
            "create": "knows"
          },
          "highlight": {
            "allowHighlighting": false
          }
        },
        {
          "id": "sociogram-prompt-2",
          "text": { "en-US": "Highlight the people you feel closest to" },
          "layout": {
            "layoutVariable": "layout"
          },
          "edges": {
            "display": ["knows"]
          },
          "highlight": {
            "allowHighlighting": true,
            "variable": "highlighted"
          }
        }
      ]
    },
    {
      "id": "dyad-census-1",
      "type": "DyadCensus",
      "label": { "en-US": "Dyad Census" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "introductionPanel": {
        "title": { "en-US": "Introduction to the Dyad Census" },
        "text": {
          "en-US": "This section will go through all possible node pairs and ask you how they are connected."
        }
      },
      "prompts": [
        {
          "id": "dyad-census-prompt-1",
          "text": { "en-US": "Do these two people know each other?" },
          "createEdge": "knows"
        }
      ]
    },
    {
      "id": "one-to-many-dyad-census-1",
      "type": "OneToManyDyadCensus",
      "label": { "en-US": "One to Many Dyad Census" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "behaviours": {
        "removeAfterConsideration": true
      },
      "prompts": [
        {
          "id": "one-to-many-dyad-census-prompt-1",
          "text": { "en-US": "Tap on all the people who this person knows" },
          "createEdge": "knows"
        }
      ]
    },
    {
      "id": "tie-strength-census-1",
      "type": "TieStrengthCensus",
      "label": { "en-US": "Tie-Strength Census" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "introductionPanel": {
        "title": { "en-US": "Introduction to the Tie-Strength Census" },
        "text": {
          "en-US": "This interface both creates an edge and assigns an ordinal value to it."
        }
      },
      "prompts": [
        {
          "id": "tie-strength-census-prompt-1",
          "text": { "en-US": "How close are these two people?" },
          "createEdge": "knows",
          "edgeVariable": "closeness",
          "negativeLabel": { "en-US": "Don't know each other" }
        }
      ]
    },
    {
      "id": "ordinal-bin-1",
      "type": "OrdinalBin",
      "label": { "en-US": "Ordinal Bin" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "ordinal-bin-prompt-1",
          "text": {
            "en-US": "How often do you have contact with this person?"
          },
          "variable": "contactFreq",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "categorical-bin-1",
      "type": "CategoricalBin",
      "label": { "en-US": "Categorical Bin" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "categorical-bin-prompt-1",
          "text": {
            "en-US": "What type of contact do you have most with this person?"
          },
          "variable": "contactType"
        }
      ]
    },
    {
      "id": "alter-form-1",
      "type": "AlterForm",
      "label": { "en-US": "Alter Form" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "form": {
        "fields": [
          {
            "variable": "relationship_to_ego",
            "prompt": { "en-US": "What is this person's relationship to you?" }
          },
          {
            "variable": "flagged",
            "prompt": { "en-US": "Does this person have this attribute?" }
          }
        ]
      },
      "introductionPanel": {
        "title": { "en-US": "Introduction to the alter form" },
        "text": { "en-US": "A few more questions about each person." }
      }
    },
    {
      "id": "alter-edge-form-1",
      "type": "AlterEdgeForm",
      "label": { "en-US": "Alter Edge Form" },
      "subject": {
        "entity": "edge",
        "type": "knows"
      },
      "form": {
        "fields": [
          {
            "variable": "edgeNotes",
            "prompt": { "en-US": "Add any notes about this relationship" }
          }
        ]
      },
      "introductionPanel": {
        "title": { "en-US": "Introduction to the alter edge form" },
        "text": { "en-US": "A few questions about each relationship." }
      }
    },
    {
      "id": "narrative-1",
      "type": "Narrative",
      "label": { "en-US": "Narrative" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "presets": [
        {
          "id": "narrative-preset-1",
          "label": { "en-US": "Default layout" },
          "layoutVariable": "layout",
          "groupVariable": "contactType",
          "edges": {
            "display": ["knows"]
          },
          "highlight": ["flagged"]
        }
      ],
      "background": {
        "concentricCircles": 4,
        "skewedTowardCenter": true
      },
      "behaviours": {
        "freeDraw": true,
        "allowRepositioning": true
      }
    },
    {
      "id": "family-pedigree-1",
      "type": "FamilyPedigree",
      "label": { "en-US": "Family Pedigree" },
      "nodeConfig": {
        "type": "family_member",
        "nodeLabelVariable": "fm_name",
        "egoVariable": "is_ego",
        "relationshipVariable": "fm_relationship_to_ego",
        "biologicalSexVariable": "biologicalSex"
      },
      "edgeConfig": {
        "type": "family_edge",
        "relationshipTypeVariable": "relationshipType",
        "isActiveVariable": "isActive",
        "isGestationalCarrierVariable": "isGestationalCarrier",
        "gameteRoleVariable": "gameteRole"
      },
      "framing": {
        "mode": "fixed",
        "value": "gamete"
      },
      "boundaries": {
        "requireGrandparents": "off",
        "requireChildrenContributors": "off"
      },
      "censusPrompt": { "en-US": "Who is in your family?" },
      "nominationPrompts": [
        {
          "id": "nomination-1",
          "text": {
            "en-US": "Who in your family has been diagnosed with condition X?"
          },
          "variable": "hasConditionX"
        }
      ]
    },
    {
      "id": "narrative-pedigree-1",
      "type": "NarrativePedigree",
      "label": { "en-US": "Narrative Pedigree" },
      "sourceStageId": "family-pedigree-1",
      "diseases": [
        {
          "id": "disease-1",
          "label": { "en-US": "Condition X" },
          "color": "node-color-seq-1",
          "variable": "hasConditionX",
          "inheritancePattern": "autosomalDominant"
        }
      ]
    },
    {
      "id": "network-composer-1",
      "type": "NetworkComposer",
      "label": { "en-US": "Network Composer" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "quickAdd": "composerName",
      "layoutVariable": "layout",
      "background": {
        "concentricCircles": 4
      }
    },
    {
      "id": "geospatial-1",
      "type": "Geospatial",
      "label": { "en-US": "Geospatial" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "mapOptions": {
        "tokenAssetId": "mapbox_token",
        "style": "mapbox://styles/mapbox/standard",
        "center": [-74.0, 40.7],
        "initialZoom": 10,
        "dataSourceAssetId": "geo_data",
        "color": "ord-color-seq-6",
        "targetFeatureProperty": "name"
      },
      "prompts": [
        {
          "id": "geospatial-prompt-1",
          "text": { "en-US": "Where do you live?" },
          "variable": "location"
        }
      ]
    },
    {
      "id": "language-chooser-1",
      "type": "LanguageChooser",
      "label": { "en-US": "Language Chooser" },
      "introduction": {
        "en-US": "Choose the language you would like to use for the rest of this interview."
      }
    }
