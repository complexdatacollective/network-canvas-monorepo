        }
      }
    },
    "node": {
      "person": {
        "name": "Person",
        "label": { "en-US": "Person" },
        "color": "node-color-seq-1",
        "icon": "add-a-person",
        "shape": { "default": "circle" },
        "variables": {
          "alter_name": {
            "name": "alter_name",
            "label": "alter_name",
            "type": "text",
            "component": "Text",
            "validation": { "required": true, "unique": true }
          },
          "relationship": {
            "name": "relationship",
            "label": "relationship",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en-US": "Spouse or partner" }, "value": "partner" },
              {
                "label": { "en-US": "Other family member" },
                "value": "family"
              },
              { "label": { "en-US": "Friend" }, "value": "friend" },
              { "label": { "en-US": "Neighbour" }, "value": "neighbour" },
              { "label": { "en-US": "Co-worker" }, "value": "coworker" },
              { "label": { "en-US": "Other" }, "value": "other" }
            ]
          },
          "contact_frequency": {
            "name": "contact_frequency",
            "label": "contact_frequency",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Less than once a year" }, "value": 1 },
              { "label": { "en-US": "A few times a year" }, "value": 2 },
              { "label": { "en-US": "Monthly" }, "value": 3 },
              { "label": { "en-US": "Weekly" }, "value": 4 },
              { "label": { "en-US": "Daily" }, "value": 5 }
            ]
          },
          "contact_mode": {
            "name": "contact_mode",
            "label": "contact_mode",
            "type": "categorical",
            "component": "CheckboxGroup",
            "options": [
              { "label": { "en-US": "In person" }, "value": "in_person" },
              { "label": { "en-US": "Phone" }, "value": "phone" },
              { "label": { "en-US": "Video call" }, "value": "video_call" },
              { "label": { "en-US": "Text or messaging" }, "value": "text" },
              { "label": { "en-US": "Social media" }, "value": "social_media" }
            ]
          },
          "lives_with": {
            "name": "lives_with",
            "label": "lives_with",
            "type": "boolean",
            "component": "Boolean",
            "options": [
              { "label": { "en-US": "Yes" }, "value": true },
              { "label": { "en-US": "No" }, "value": false }
            ]
          },
          "support_emotional": {
            "name": "support_emotional",
            "label": "support_emotional",
            "type": "boolean",
            "component": "Boolean",
            "options": [
              { "label": { "en-US": "Yes" }, "value": true },
              { "label": { "en-US": "No" }, "value": false }
            ]
          },
          "support_practical": {
            "name": "support_practical",
            "label": "support_practical",
            "type": "boolean",
            "component": "Boolean",
            "options": [
              { "label": { "en-US": "Yes" }, "value": true },
              { "label": { "en-US": "No" }, "value": false }
            ]
          },
          "age_band": {
            "name": "age_band",
            "label": "age_band",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Under 18" }, "value": 1 },
              { "label": { "en-US": "18 to 29" }, "value": 2 },
              { "label": { "en-US": "30 to 49" }, "value": 3 },
              { "label": { "en-US": "50 to 64" }, "value": 4 },
              { "label": { "en-US": "65 to 79" }, "value": 5 },
              { "label": { "en-US": "80 or older" }, "value": 6 }
            ]
          },
          "closeness": {
            "name": "closeness",
            "label": "closeness",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Not close" }, "value": 1 },
              { "label": { "en-US": "Somewhat close" }, "value": 2 },
              { "label": { "en-US": "Close" }, "value": 3 },
              { "label": { "en-US": "Very close" }, "value": 4 }
            ]
          }
        }
      }
    },
    "edge": {
      "knows": {
        "name": "Knows",
        "label": { "en-US": "Knows" },
        "color": "edge-color-seq-1"
      }
    }
  },
  "stages": [
    {
      "id": "information-researcher-notes",
      "type": "Information",
      "label": { "en-US": "Template notes (delete before fielding)" },
      "title": { "en-US": "Template notes" },
      "items": [
        {
          "id": "researcher-notes",
          "type": "text",
          "content": {
            "en-US": "## For researchers\n\n_Delete this screen before you field the study. It lists the validated scales and reports this template draws on._\n\n- [Hughes ME, Waite LJ, Hawkley LC, Cacioppo JT (2004). A Short Scale for Measuring Loneliness in Large Surveys (UCLA-3). *Research on Aging*.](https://pmc.ncbi.nlm.nih.gov/articles/PMC2394670/)\n- [De Jong Gierveld J, Van Tilburg T (2006). A 6-Item Scale for Overall, Emotional, and Social Loneliness. *Research on Aging*.](https://journals.sagepub.com/doi/10.1177/0164027506289723)\n- [Lubben J et al. (2006). Lubben Social Network Scale (LSNS-6).](https://www.bc.edu/content/dam/bc1/schools/sw/lubben/LSNS6.pdf)\n- [US Surgeon General (2023). Our Epidemic of Loneliness and Isolation.](https://www.hhs.gov/surgeongeneral/priorities/connection/index.html)"
          }
        }
      ]
    },
    {
      "id": "information-intro",
      "type": "Information",
      "label": { "en-US": "Welcome" },
      "title": { "en-US": "About this study" },
      "items": [
        {
          "id": "intro-welcome",
          "type": "text",
          "content": {
            "en-US": "## Welcome\n\nThank you for taking part. In this interview we will talk about the **people you are close to and in contact with**, and about how connected you feel. There are no right or wrong answers — we are simply interested in your own experience."
          }
        }
      ]
    },
    {
      "id": "ego-form-demographics",
      "type": "EgoForm",
      "label": { "en-US": "About You" },
      "introductionPanel": {
        "title": { "en-US": "About you and your household" },
        "text": {
          "en-US": "To begin, we would like to ask a few questions about **you** and your current living situation. Your answers help us understand the context of your social connections."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "living_situation",
            "prompt": {
              "en-US": "Which of the following best describes your current living situation?"
            }
          },
          {
            "variable": "self_rated_health",
            "prompt": { "en-US": "In general, how would you rate your health?" }
          }
        ]
      }
    },
    {
      "id": "name-generator-confidants",
      "type": "NameGenerator",
      "label": { "en-US": "People You Discuss Important Matters With" },
      "interviewScript": "Use the standard General Social Survey 'important matters' confidant generator. Allow the respondent to name as many or as few people as they wish; do not prompt for a target number.",
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "form": {
        "title": { "en-US": "Add Person" },
        "fields": [
          {
            "variable": "alter_name",
            "prompt": {
              "en-US": "What is this person's first name or initials?"
            }
          }
        ]
      },
      "prompts": [
        {
          "id": "gss-important-matters",
          "text": {
            "en-US": "Looking back over the last six months, who are the people with whom you discussed matters important to you?"
          }
        }
      ]
    },
    {
      "id": "ordinal-bin-closeness",
      "type": "OrdinalBin",
      "label": { "en-US": "How Close Are They?" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "closeness-bands",
          "text": {
            "en-US": "Drag each person into the band that best describes how close you feel to them, from **not close** to **very close**."
          },
          "variable": "closeness",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "alter-form-attributes",
      "type": "AlterForm",
      "label": { "en-US": "About Each Person" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "introductionPanel": {
        "title": { "en-US": "A little more about each person" },
        "text": {
          "en-US": "For each person you named, we would like to ask about your **contact** with them and the kinds of **support** they provide."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "relationship",
            "prompt": { "en-US": "What is this person's relationship to you?" }
          },
          {
            "variable": "age_band",
            "prompt": { "en-US": "Roughly how old is this person?" }
          },
          {
            "variable": "contact_frequency",
            "prompt": {
              "en-US": "How often are you in contact with this person?"
            }
          },
          {
            "variable": "contact_mode",
            "prompt": {
              "en-US": "How do you usually keep in contact with this person?"
            },
            "hint": { "en-US": "Select all that apply." }
          },
          {
            "variable": "lives_with",
            "prompt": { "en-US": "Does this person live with you?" }
          },
          {
            "variable": "support_emotional",
            "prompt": {
              "en-US": "Could you turn to this person for **emotional** support?"
            },
            "hint": {
              "en-US": "Such as talking things over when you feel down."
            }
          },
          {
            "variable": "support_practical",
            "prompt": {
              "en-US": "Could you turn to this person for **practical** support?"
            },
            "hint": { "en-US": "Such as help with tasks, transport, or money." }
          }
        ]
      }
    },
    {
      "id": "dyad-census-knows",
      "type": "OneToManyDyadCensus",
      "label": { "en-US": "Who Knows Whom" },
      "interviewScript": "For each person in turn, the respondent taps everyone else that person knows. This systematically elicits the complete set of alter-alter ties — more reliably than a free-draw sociogram, which tends to under-capture them — giving the density and fragmentation measures that isolation analysis depends on. It is also lower-burden than an all-pairs dyad census.",
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "behaviours": {
        "removeAfterConsideration": true
      },
      "prompts": [
        {
          "id": "p-knows",
          "text": {
            "en-US": "Here is one of the people you named. Tap **everyone else who knows this person**, as far as you are aware."
          },
          "createEdge": "knows"
        }
      ]
    },
    {
      "id": "ego-form-scales",
      "type": "EgoForm",
      "label": { "en-US": "Your Feelings About Connection" },
      "introductionPanel": {
        "title": { "en-US": "Your feelings about social connection" },
        "text": {
          "en-US": "Finally, we would like to understand how you **feel** about your social connections. There are no right or wrong answers."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "ucla_1",
            "prompt": {
              "en-US": "How often do you feel that you lack companionship?"
            }
          },
          {
            "variable": "ucla_2",
            "prompt": { "en-US": "How often do you feel left out?" }
          },
          {
            "variable": "ucla_3",
            "prompt": { "en-US": "How often do you feel isolated from others?" }
          },
          {
            "variable": "djg_1",
            "prompt": { "en-US": "I experience a general sense of emptiness." }
          },
          {
            "variable": "djg_2",
            "prompt": { "en-US": "I miss having people around me." }
          },
          {
            "variable": "djg_3",
            "prompt": { "en-US": "I often feel rejected." }
          },
          {
            "variable": "djg_4",
            "prompt": {
              "en-US": "There are plenty of people I can rely on when I have problems."
            }
          },
          {
            "variable": "djg_5",
            "prompt": {
              "en-US": "There are many people I can trust completely."
            }
          },
          {
            "variable": "djg_6",
            "prompt": { "en-US": "There are enough people I feel close to." }
          },
          {
            "variable": "lsns_1",
            "prompt": {
              "en-US": "Thinking about your relatives, how many do you see or hear from at least once a month?"
            }
          },
          {
            "variable": "lsns_2",
            "prompt": {
              "en-US": "How many relatives do you feel close enough to that you can talk to them about private matters?"
            }
          },
          {
            "variable": "lsns_3",
            "prompt": {
              "en-US": "How many relatives do you feel close enough to that you could call on them for help?"
            }
          },
          {
            "variable": "lsns_4",
            "prompt": {
              "en-US": "Thinking about your friends, how many do you see or hear from at least once a month?"
            }
          },
          {
            "variable": "lsns_5",
            "prompt": {
              "en-US": "How many friends do you feel close enough to that you can talk to them about private matters?"
            }
          },
          {
            "variable": "lsns_6",
            "prompt": {
              "en-US": "How many friends do you feel close enough to that you could call on them for help?"
            }
          }
        ]
      }
    },
    {
      "id": "finish",
      "finishLabel": {
        "en-US": "Finish"
      },
      "finishConfirmation": {
        "en-US": "Are you sure you want to finish the interview?"
      },
      "finishedNotice": {
        "en-US": "This interview is finished, and its answers can no longer be changed."
      },
      "finishFailed": {
