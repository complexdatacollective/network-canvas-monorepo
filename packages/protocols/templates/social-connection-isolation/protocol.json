            { "label": { "en-US": "Often" }, "value": 3 }
          ],
          "validation": { "required": true }
        },
        "ucla_2": {
          "name": "ucla_2",
          "label": "ucla_2",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Hardly ever" }, "value": 1 },
            { "label": { "en-US": "Some of the time" }, "value": 2 },
            { "label": { "en-US": "Often" }, "value": 3 }
          ],
          "validation": { "required": true }
        },
