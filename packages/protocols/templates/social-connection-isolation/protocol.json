            { "label": { "en": "Some of the time" }, "value": 2 },
            { "label": { "en": "Often" }, "value": 3 }
          ],
          "validation": { "required": true }
        },
        "djg_1": {
          "name": "djg_1",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "No" }, "value": 1 },
            { "label": { "en": "More or less" }, "value": 2 },
            { "label": { "en": "Yes" }, "value": 3 }
          ],
          "validation": { "required": true }
        },
        "djg_2": {
          "name": "djg_2",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "No" }, "value": 1 },
            { "label": { "en": "More or less" }, "value": 2 },
            { "label": { "en": "Yes" }, "value": 3 }
          ],
          "validation": { "required": true }
