            { "label": { "en": "Three or four" }, "value": 3 },
            { "label": { "en": "Five to eight" }, "value": 4 },
            { "label": { "en": "Nine or more" }, "value": 5 }
          ],
          "validation": { "required": true }
        },
        "lsns_3": {
          "name": "lsns_3",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "None" }, "value": 0 },
            { "label": { "en": "One" }, "value": 1 },
            { "label": { "en": "Two" }, "value": 2 },
            { "label": { "en": "Three or four" }, "value": 3 },
            { "label": { "en": "Five to eight" }, "value": 4 },
            { "label": { "en": "Nine or more" }, "value": 5 }
          ],
          "validation": { "required": true }
        },
        "lsns_4": {
          "name": "lsns_4",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "None" }, "value": 0 },
            { "label": { "en": "One" }, "value": 1 },
            { "label": { "en": "Two" }, "value": 2 },
            { "label": { "en": "Three or four" }, "value": 3 },
            { "label": { "en": "Five to eight" }, "value": 4 },
            { "label": { "en": "Nine or more" }, "value": 5 }
          ],
          "validation": { "required": true }
        },
        "lsns_5": {
          "name": "lsns_5",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "None" }, "value": 0 },
            { "label": { "en": "One" }, "value": 1 },
            { "label": { "en": "Two" }, "value": 2 },
            { "label": { "en": "Three or four" }, "value": 3 },
            { "label": { "en": "Five to eight" }, "value": 4 },
            { "label": { "en": "Nine or more" }, "value": 5 }
          ],
          "validation": { "required": true }
        },
        "lsns_6": {
          "name": "lsns_6",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "None" }, "value": 0 },
            { "label": { "en": "One" }, "value": 1 },
            { "label": { "en": "Two" }, "value": 2 },
            { "label": { "en": "Three or four" }, "value": 3 },
            { "label": { "en": "Five to eight" }, "value": 4 },
            { "label": { "en": "Nine or more" }, "value": 5 }
          ],
          "validation": { "required": true }
        }
      }
    },
    "node": {
      "person": {
        "name": "Person",
        "color": "node-color-seq-1",
        "icon": "add-a-person",
        "shape": { "default": "circle" },
        "variables": {
          "alter_name": {
            "name": "alter_name",
            "type": "text",
            "component": "Text",
            "validation": { "required": true, "unique": true }
          },
          "relationship": {
            "name": "relationship",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en": "Spouse or partner" }, "value": "partner" },
              {
                "label": { "en": "Other family member" },
                "value": "family"
              },
              { "label": { "en": "Friend" }, "value": "friend" },
              { "label": { "en": "Neighbour" }, "value": "neighbour" },
              { "label": { "en": "Co-worker" }, "value": "coworker" },
              { "label": { "en": "Other" }, "value": "other" }
            ]
          },
          "contact_frequency": {
            "name": "contact_frequency",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Less than once a year" }, "value": 1 },
              { "label": { "en": "A few times a year" }, "value": 2 },
              { "label": { "en": "Monthly" }, "value": 3 },
              { "label": { "en": "Weekly" }, "value": 4 },
              { "label": { "en": "Daily" }, "value": 5 }
            ]
          },
          "contact_mode": {
            "name": "contact_mode",
            "type": "categorical",
            "component": "CheckboxGroup",
            "options": [
              { "label": { "en": "In person" }, "value": "in_person" },
              { "label": { "en": "Phone" }, "value": "phone" },
              { "label": { "en": "Video call" }, "value": "video_call" },
              { "label": { "en": "Text or messaging" }, "value": "text" },
              { "label": { "en": "Social media" }, "value": "social_media" }
            ]
          },
          "lives_with": {
            "name": "lives_with",
            "type": "boolean",
            "component": "Boolean",
            "options": [
              { "label": { "en": "Yes" }, "value": true },
              { "label": { "en": "No" }, "value": false }
            ]
          },
          "support_emotional": {
            "name": "support_emotional",
            "type": "boolean",
            "component": "Boolean",
            "options": [
              { "label": { "en": "Yes" }, "value": true },
              { "label": { "en": "No" }, "value": false }
            ]
          },
          "support_practical": {
            "name": "support_practical",
            "type": "boolean",
            "component": "Boolean",
            "options": [
              { "label": { "en": "Yes" }, "value": true },
              { "label": { "en": "No" }, "value": false }
            ]
          },
          "age_band": {
            "name": "age_band",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Under 18" }, "value": 1 },
              { "label": { "en": "18 to 29" }, "value": 2 },
              { "label": { "en": "30 to 49" }, "value": 3 },
              { "label": { "en": "50 to 64" }, "value": 4 },
              { "label": { "en": "65 to 79" }, "value": 5 },
              { "label": { "en": "80 or older" }, "value": 6 }
            ]
          },
          "closeness": {
            "name": "closeness",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Not close" }, "value": 1 },
              { "label": { "en": "Somewhat close" }, "value": 2 },
              { "label": { "en": "Close" }, "value": 3 },
              { "label": { "en": "Very close" }, "value": 4 }
            ]
          }
        }
      }
    },
    "edge": { "knows": { "name": "Knows", "color": "edge-color-seq-1" } }
  },
  "stages": [
    {
      "id": "information-researcher-notes",
      "type": "Information",
      "label": { "en": "Template notes (delete before fielding)" },
      "title": { "en": "Template notes" },
      "items": [
        {
          "id": "researcher-notes",
          "type": "text",
          "content": {
            "en": "## For researchers\n\n_Delete this screen before you field the study. It lists the validated scales and reports this template draws on._\n\n- [Hughes ME, Waite LJ, Hawkley LC, Cacioppo JT (2004). A Short Scale for Measuring Loneliness in Large Surveys (UCLA-3). *Research on Aging*.](https://pmc.ncbi.nlm.nih.gov/articles/PMC2394670/)\n- [De Jong Gierveld J, Van Tilburg T (2006). A 6-Item Scale for Overall, Emotional, and Social Loneliness. *Research on Aging*.](https://journals.sagepub.com/doi/10.1177/0164027506289723)\n- [Lubben J et al. (2006). Lubben Social Network Scale (LSNS-6).](https://www.bc.edu/content/dam/bc1/schools/sw/lubben/LSNS6.pdf)\n- [US Surgeon General (2023). Our Epidemic of Loneliness and Isolation.](https://www.hhs.gov/surgeongeneral/priorities/connection/index.html)"
          }
        }
      ]
    },
    {
      "id": "information-intro",
      "type": "Information",
      "label": { "en": "Welcome" },
      "title": { "en": "About this study" },
      "items": [
        {
          "id": "intro-welcome",
          "type": "text",
          "content": {
            "en": "## Welcome\n\nThank you for taking part. In this interview we will talk about the **people you are close to and in contact with**, and about how connected you feel. There are no right or wrong answers — we are simply interested in your own experience."
          }
        }
      ]
    },
    {
      "id": "ego-form-demographics",
      "type": "EgoForm",
      "label": { "en": "About You" },
      "introductionPanel": {
        "title": { "en": "About you and your household" },
        "text": {
          "en": "To begin, we would like to ask a few questions about **you** and your current living situation. Your answers help us understand the context of your social connections."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "living_situation",
            "prompt": {
              "en": "Which of the following best describes your current living situation?"
            }
          },
          {
            "variable": "self_rated_health",
            "prompt": { "en": "In general, how would you rate your health?" }
          }
        ]
      }
    },
    {
      "id": "name-generator-confidants",
      "type": "NameGenerator",
      "label": { "en": "People You Discuss Important Matters With" },
      "interviewScript": "Use the standard General Social Survey 'important matters' confidant generator. Allow the respondent to name as many or as few people as they wish; do not prompt for a target number.",
      "subject": { "entity": "node", "type": "person" },
      "form": {
        "title": { "en": "Add Person" },
        "fields": [
          {
            "variable": "alter_name",
            "prompt": {
              "en": "What is this person's first name or initials?"
            }
          }
        ]
      },
      "prompts": [
        {
          "id": "gss-important-matters",
          "text": {
            "en": "Looking back over the last six months, who are the people with whom you discussed matters important to you?"
          }
        }
      ]
    },
    {
      "id": "ordinal-bin-closeness",
      "behaviours": { "interactionMode": "select" },
      "type": "OrdinalBin",
      "label": { "en": "How Close Are They?" },
      "subject": { "entity": "node", "type": "person" },
      "prompts": [
        {
          "id": "closeness-bands",
          "text": {
            "en": "For each person, tap the band that best describes how close you feel to them, from **not close** to **very close**."
          },
          "variable": "closeness",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "alter-form-attributes-introduction",
      "type": "Information",
      "label": { "en": "A little more about each person" },
      "title": { "en": "A little more about each person" },
      "items": [
        {
          "id": "introduction-text",
          "type": "text",
          "content": {
            "en": "For each person you named, we would like to ask about your **contact** with them and the kinds of **support** they provide."
          }
        }
      ]
    },
    {
      "id": "alter-form-attributes",
      "dynamicValues": { "nodeLabel": { "path": "node.$label" } },
      "type": "AlterForm",
      "label": { "en": "About Each Person" },
      "subject": { "entity": "node", "type": "person" },
      "form": {
        "fields": [
          {
            "variable": "relationship",
            "prompt": { "en": "What is {nodeLabel}'s relationship to you?" }
          },
          {
            "variable": "age_band",
            "prompt": { "en": "Roughly how old is {nodeLabel}?" }
          },
          {
            "variable": "contact_frequency",
            "prompt": {
              "en": "How often are you in contact with {nodeLabel}?"
            }
          },
          {
            "variable": "contact_mode",
            "prompt": {
              "en": "How do you usually keep in contact with {nodeLabel}?"
            },
            "hint": { "en": "Select all that apply." }
          },
          {
            "variable": "lives_with",
            "prompt": { "en": "Does {nodeLabel} live with you?" }
          },
          {
            "variable": "support_emotional",
            "prompt": {
              "en": "Could you turn to {nodeLabel} for **emotional** support?"
            },
            "hint": {
              "en": "Such as talking things over when you feel down."
            }
          },
          {
            "variable": "support_practical",
            "prompt": {
              "en": "Could you turn to {nodeLabel} for **practical** support?"
            },
            "hint": { "en": "Such as help with tasks, transport, or money." }
          }
        ]
      }
    },
    {
      "id": "dyad-census-knows",
      "dynamicValues": { "focalLabel": { "path": "one_to_many.focal.$label" } },
      "type": "OneToManyDyadCensus",
      "label": { "en": "Who Knows Whom" },
      "interviewScript": "For each person in turn, the respondent taps everyone else that person knows. This systematically elicits the complete set of alter-alter ties — more reliably than a free-draw sociogram, which tends to under-capture them — giving the density and fragmentation measures that isolation analysis depends on. It is also lower-burden than an all-pairs dyad census.",
      "subject": { "entity": "node", "type": "person" },
      "behaviours": { "removeAfterConsideration": true },
      "prompts": [
        {
          "id": "p-knows",
          "text": {
            "en": "Tap **everyone else who knows {focalLabel}**, as far as you are aware."
          },
          "createEdge": "knows"
        }
      ]
    },
    {
      "id": "ego-form-scales",
      "type": "EgoForm",
      "label": { "en": "Your Feelings About Connection" },
      "introductionPanel": {
        "title": { "en": "Your feelings about social connection" },
        "text": {
          "en": "Finally, we would like to understand how you **feel** about your social connections. There are no right or wrong answers."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "ucla_1",
            "prompt": {
              "en": "How often do you feel that you lack companionship?"
            }
          },
          {
            "variable": "ucla_2",
            "prompt": { "en": "How often do you feel left out?" }
          },
          {
            "variable": "ucla_3",
            "prompt": { "en": "How often do you feel isolated from others?" }
          },
          {
            "variable": "djg_1",
            "prompt": { "en": "I experience a general sense of emptiness." }
          },
          {
            "variable": "djg_2",
            "prompt": { "en": "I miss having people around me." }
          },
          {
            "variable": "djg_3",
            "prompt": { "en": "I often feel rejected." }
          },
          {
            "variable": "djg_4",
            "prompt": {
              "en": "There are plenty of people I can rely on when I have problems."
            }
          },
          {
            "variable": "djg_5",
            "prompt": {
              "en": "There are many people I can trust completely."
            }
          },
          {
            "variable": "djg_6",
            "prompt": { "en": "There are enough people I feel close to." }
          },
          {
            "variable": "lsns_1",
            "prompt": {
              "en": "Thinking about your relatives, how many do you see or hear from at least once a month?"
            }
          },
          {
            "variable": "lsns_2",
            "prompt": {
              "en": "How many relatives do you feel close enough to that you can talk to them about private matters?"
            }
          },
          {
            "variable": "lsns_3",
            "prompt": {
              "en": "How many relatives do you feel close enough to that you could call on them for help?"
            }
          },
          {
            "variable": "lsns_4",
            "prompt": {
              "en": "Thinking about your friends, how many do you see or hear from at least once a month?"
            }
          },
          {
            "variable": "lsns_5",
            "prompt": {
              "en": "How many friends do you feel close enough to that you can talk to them about private matters?"
            }
          },
          {
            "variable": "lsns_6",
            "prompt": {
              "en": "How many friends do you feel close enough to that you could call on them for help?"
            }
          }
        ]
      }
    },
    {
      "id": "finish",
      "finishLabel": { "en": "Finish" },
      "finishConfirmation": {
        "en": "Are you sure you want to finish the interview?"
      },
      "finishFailed": {
        "en": "The interview could not be finished. Please try again. If the problem continues, contact the study organizer."
      },
      "type": "FinishSession",
      "mode": "confirmation",
      "label": { "en": "Finish Interview" },
      "content": {
        "en": "# Finish Interview\n\nYou have reached the end of the interview. If you are satisfied with the information you have entered, you may finish the interview now."
      },
      "finishedContent": {
        "en": "# Interview Finished\n\nThank you for participating!"
      },
      "outcome": "completed"
    }
  ],
  "interfaceText": {
    "navigation": {
      "exitInterview": { "en": "Exit interview" },
      "exitInterviewDescription": {
        "en": "Your answers so far will be saved and you can continue later."
      },
      "back": { "en": "Back" },
      "continue": { "en": "Continue" },
      "exitFailed": {
        "en": "Your answers could not be saved, so the interview has not been closed. Please try again. If the problem continues, contact the study organizer."
      }
    },
    "interviewer": {
      "exitReview": { "en": "Exit review" },
      "exitReviewTitle": { "en": "Exit this review?" },
      "exitReviewDescription": {
        "en": "Changes made during this review will not be saved."
      },
      "hiddenScreen": { "en": "Hidden by answers" },
      "outsidePath": { "en": "Outside current path" },
      "showScreenTitle": { "en": "Show this screen?" },
      "hiddenScreenDescription": {
        "en": "This screen is hidden based on the answers given so far. Do you want to show it anyway?"
      },
      "outsidePathDescription": {
        "en": "This screen is outside the current interview path based on the answers given so far. Do you want to show it anyway?"
      },
      "showScreen": { "en": "Show screen" }
    },
    "buttons": {
      "cancel": { "en": "Cancel" },
      "done": { "en": "Done" },
      "delete": { "en": "Delete" },
