{
  "name": "Social Connection & Isolation",
  "description": "An example template that pairs a personal-network map with validated loneliness scales (UCLA-3, De Jong Gierveld, and Lubben LSNS-6), so a study can capture both social isolation (network structure) and subjective loneliness. Designed with older adults in mind.",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en-US", "locales": ["en-US"] },
  "lastModified": "2026-06-15T00:00:00.000Z",
  "codebook": {
    "ego": {
      "variables": {
        "living_situation": {
          "name": "living_situation",
          "label": "living_situation",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            { "label": { "en-US": "I live alone" }, "value": "alone" },
            {
              "label": { "en-US": "I live with a spouse or partner only" },
              "value": "partner"
            },
            {
              "label": { "en-US": "I live with family (other than a partner)" },
              "value": "family"
            },
            {
              "label": { "en-US": "I live with friends or housemates" },
              "value": "housemates"
            },
            {
              "label": { "en-US": "I live in a care or residential setting" },
              "value": "residential"
            },
            {
              "label": { "en-US": "Other living arrangement" },
              "value": "other"
            }
          ],
          "validation": { "required": true }
        },
        "self_rated_health": {
