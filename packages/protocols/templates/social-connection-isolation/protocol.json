{
  "name": "Social Connection & Isolation",
  "description": "An example template that pairs a personal-network map with validated loneliness scales (UCLA-3, De Jong Gierveld, and Lubben LSNS-6), so a study can capture both social isolation (network structure) and subjective loneliness. Designed with older adults in mind.",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en", "locales": ["en"] },
  "lastModified": "2026-06-15T00:00:00.000Z",
  "codebook": {
    "ego": {
      "variables": {
        "living_situation": {
          "name": "living_situation",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            { "label": { "en": "I live alone" }, "value": "alone" },
            {
              "label": { "en": "I live with a spouse or partner only" },
              "value": "partner"
            },
            {
              "label": { "en": "I live with family (other than a partner)" },
              "value": "family"
            },
            {
              "label": { "en": "I live with friends or housemates" },
              "value": "housemates"
            },
            {
              "label": { "en": "I live in a care or residential setting" },
              "value": "residential"
            },
            {
              "label": { "en": "Other living arrangement" },
              "value": "other"
            }
          ],
          "validation": { "required": true }
        },
        "self_rated_health": {
          "name": "self_rated_health",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Poor" }, "value": 1 },
            { "label": { "en": "Fair" }, "value": 2 },
            { "label": { "en": "Good" }, "value": 3 },
            { "label": { "en": "Very good" }, "value": 4 },
            { "label": { "en": "Excellent" }, "value": 5 }
          ],
          "validation": { "required": true }
        },
        "ucla_1": {
          "name": "ucla_1",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Hardly ever" }, "value": 1 },
            { "label": { "en": "Some of the time" }, "value": 2 },
            { "label": { "en": "Often" }, "value": 3 }
          ],
          "validation": { "required": true }
        },
        "ucla_2": {
          "name": "ucla_2",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Hardly ever" }, "value": 1 },
            { "label": { "en": "Some of the time" }, "value": 2 },
            { "label": { "en": "Often" }, "value": 3 }
          ],
          "validation": { "required": true }
        },
        "ucla_3": {
          "name": "ucla_3",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
