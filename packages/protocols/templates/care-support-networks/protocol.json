{
  "name": "Care & Support Networks",
  "description": "An example of a study that looks at who supports a participant through a period of care, and the kinds of support they provide — emotional, practical, informational, and financial — across both informal and professional sources. Configured here for the perinatal period (pregnancy and new parenthood).",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en", "locales": ["en"] },
  "lastModified": "2026-06-15T00:00:00.000Z",
  "codebook": {
    "ego": {
      "variables": {
        "care_stage": {
          "name": "care_stage",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            { "label": { "en": "Pregnant" }, "value": "pregnant" },
            {
              "label": { "en": "Postpartum (baby already born)" },
              "value": "postpartum"
            }
          ],
          "validation": { "required": true, "maxSelected": 1 }
        },
        "weeks_since_birth": {
          "name": "weeks_since_birth",
          "type": "number",
          "component": "Number",
          "validation": { "minValue": 0, "maxValue": 104 }
        },
        "living_situation": {
          "name": "living_situation",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            {
              "label": { "en": "Living with a partner / spouse" },
              "value": "with_partner"
            },
            {
              "label": { "en": "Living with other family or relatives" },
              "value": "with_family"
            },
            {
              "label": { "en": "Living with friends or housemates" },
              "value": "with_others"
            },
            { "label": { "en": "Living alone" }, "value": "alone" }
          ]
        },
        "epds_1": {
          "name": "epds_1",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "As much as I always could" }, "value": 0 },
            { "label": { "en": "Not quite so much now" }, "value": 1 },
            { "label": { "en": "Definitely not so much now" }, "value": 2 },
            { "label": { "en": "Not at all" }, "value": 3 }
          ]
        },
        "epds_2": {
          "name": "epds_2",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "As much as I ever did" }, "value": 0 },
            { "label": { "en": "Rather less than I used to" }, "value": 1 },
            {
              "label": { "en": "Definitely less than I used to" },
              "value": 2
            },
            { "label": { "en": "Hardly at all" }, "value": 3 }
          ]
        },
        "epds_3": {
          "name": "epds_3",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Yes, most of the time" }, "value": 3 },
            { "label": { "en": "Yes, some of the time" }, "value": 2 },
            { "label": { "en": "Not very often" }, "value": 1 },
            { "label": { "en": "No, never" }, "value": 0 }
          ]
        },
        "epds_4": {
          "name": "epds_4",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "No, not at all" }, "value": 0 },
            { "label": { "en": "Hardly ever" }, "value": 1 },
            { "label": { "en": "Yes, sometimes" }, "value": 2 },
            { "label": { "en": "Yes, very often" }, "value": 3 }
          ]
        },
        "epds_5": {
          "name": "epds_5",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Yes, quite a lot" }, "value": 3 },
            { "label": { "en": "Yes, sometimes" }, "value": 2 },
            { "label": { "en": "No, not much" }, "value": 1 },
            { "label": { "en": "No, not at all" }, "value": 0 }
          ]
        },
        "epds_6": {
          "name": "epds_6",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            {
              "label": {
                "en": "Yes, most of the time I haven't been able to cope at all"
              },
              "value": 3
            },
            {
              "label": {
                "en": "Yes, sometimes I haven't been coping as well as usual"
              },
              "value": 2
            },
            {
              "label": {
                "en": "No, most of the time I have coped quite well"
              },
              "value": 1
            },
            {
              "label": { "en": "No, I have been coping as well as ever" },
              "value": 0
            }
          ]
        },
        "epds_7": {
          "name": "epds_7",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Yes, most of the time" }, "value": 3 },
            { "label": { "en": "Yes, sometimes" }, "value": 2 },
            { "label": { "en": "Not very often" }, "value": 1 },
            { "label": { "en": "No, not at all" }, "value": 0 }
          ]
        },
        "epds_8": {
          "name": "epds_8",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Yes, most of the time" }, "value": 3 },
            { "label": { "en": "Yes, quite often" }, "value": 2 },
            { "label": { "en": "Not very often" }, "value": 1 },
            { "label": { "en": "No, not at all" }, "value": 0 }
          ]
        },
        "epds_9": {
          "name": "epds_9",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Yes, most of the time" }, "value": 3 },
            { "label": { "en": "Yes, quite often" }, "value": 2 },
            { "label": { "en": "Only occasionally" }, "value": 1 },
            { "label": { "en": "No, never" }, "value": 0 }
          ]
        },
        "epds_10": {
          "name": "epds_10",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Yes, quite often" }, "value": 3 },
            { "label": { "en": "Sometimes" }, "value": 2 },
            { "label": { "en": "Hardly ever" }, "value": 1 },
            { "label": { "en": "Never" }, "value": 0 }
          ]
        }
      }
    },
    "node": {
      "supporter": {
        "name": "Supporter",
        "color": "node-color-seq-1",
        "icon": "add-a-person",
        "shape": { "default": "circle" },
        "variables": {
          "supporter_name": {
            "name": "supporter_name",
            "type": "text",
            "component": "Text",
            "validation": { "required": true, "unique": true }
          },
          "relationship": {
            "name": "relationship",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en": "Partner or spouse" }, "value": "partner" },
              {
                "label": { "en": "Parent or parent-in-law" },
                "value": "parent"
              },
              {
                "label": { "en": "Other family member" },
                "value": "family"
              },
              { "label": { "en": "Friend" }, "value": "friend" },
              {
                "label": { "en": "Another parent / peer" },
                "value": "peer_parent"
              },
              { "label": { "en": "Neighbour" }, "value": "neighbour" },
              {
                "label": { "en": "Healthcare or service provider" },
                "value": "provider"
              }
            ]
          },
          "formal_informal": {
            "name": "formal_informal",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              {
                "label": { "en": "Informal (family, friends, peers)" },
                "value": "informal"
              },
              {
                "label": {
                  "en": "Formal or professional (clinician, doula, home-visiting nurse, community health worker)"
                },
                "value": "formal"
              }
            ]
          },
          "support_functions": {
            "name": "support_functions",
            "type": "categorical",
            "component": "CheckboxGroup",
            "options": [
              {
                "label": { "en": "Emotional support" },
                "value": "emotional"
              },
              {
                "label": { "en": "Information or advice" },
                "value": "informational"
              },
              {
                "label": { "en": "Practical help or childcare" },
                "value": "practical"
              },
              { "label": { "en": "Financial help" }, "value": "financial" }
            ],
            "validation": { "minSelected": 1 }
          },
          "proximity": {
            "name": "proximity",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              {
                "label": { "en": "Same household" },
                "value": "same_household"
              },
              { "label": { "en": "Nearby" }, "value": "nearby" },
              { "label": { "en": "Far away" }, "value": "far_away" },
              { "label": { "en": "Online only" }, "value": "online_only" }
            ]
          },
          "contact_frequency": {
            "name": "contact_frequency",
            "type": "ordinal",
            "component": "RadioGroup",
            "options": [
              { "label": { "en": "Every day" }, "value": 5 },
              { "label": { "en": "A few times a week" }, "value": 4 },
              { "label": { "en": "About once a week" }, "value": 3 },
              { "label": { "en": "A few times a month" }, "value": 2 },
              { "label": { "en": "Less than once a month" }, "value": 1 }
            ]
          },
          "reliance": {
            "name": "reliance",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Not at all" }, "value": 1 },
              { "label": { "en": "A little" }, "value": 2 },
              { "label": { "en": "A moderate amount" }, "value": 3 },
              { "label": { "en": "A lot" }, "value": 4 },
              { "label": { "en": "Completely" }, "value": 5 }
            ]
          },
          "layout": { "name": "layout", "type": "layout" }
        }
      }
    }
  },
  "stages": [
    {
      "id": "information-researcher-notes",
      "type": "Information",
      "label": { "en": "Template notes (delete before fielding)" },
      "title": { "en": "Template notes" },
      "items": [
        {
          "id": "researcher-notes",
          "type": "text",
          "content": {
            "en": "## For researchers\n\n_Delete this screen before you field the study._\n\n**Clinical safety:** the EPDS is a screening tool, not a diagnostic instrument. Item 10 screens for thoughts of self-harm, so before fielding put a safety protocol in place — interviewer training, an escalation pathway, and local crisis-line and referral details — for any participant who endorses item 10 or otherwise shows distress.\n\nThe instruments this template draws on:\n\n- [Cox JL, Holden JM, Sagovsky R (1987). Detection of postnatal depression: the 10-item Edinburgh Postnatal Depression Scale (EPDS). *Br J Psychiatry* 150:782–786.](https://pubmed.ncbi.nlm.nih.gov/3651732/)\n- [Sherbourne CD, Stewart AL (1991). The MOS Social Support Survey. *Soc Sci Med* 32(6):705–714.](https://www.rand.org/pubs/reprints/RP218.html)"
          }
        }
      ]
    },
    {
      "id": "information-intro",
      "type": "Information",
      "label": { "en": "Welcome" },
      "title": { "en": "About this study" },
      "items": [
        {
          "id": "intro-welcome",
          "type": "text",
          "content": {
            "en": "## Welcome\n\nThank you for taking part. In this interview we will talk about the **people who support you** during this period, and the kinds of help they provide. There are no right or wrong answers — we are interested in your own experience."
          }
        }
      ]
    },
    {
      "id": "ego-care-context",
      "type": "EgoForm",
      "label": { "en": "About you and your care episode" },
      "interviewScript": "Clinical safety: EPDS item 10 screens for thoughts of self-harm. Before fielding this protocol, put a safety protocol in place — interviewer training, an escalation pathway, and local crisis-line / referral details — for any participant who endorses item 10 or otherwise shows distress. The software records responses but does not act on them.",
      "introductionPanel": {
        "title": { "en": "About you right now" },
        "text": {
          "en": "First, a few questions about where you are in your care journey, and how you have been feeling.\n\nThe questions about your mood come from the **Edinburgh Postnatal Depression Scale (EPDS)**. There are no right or wrong answers. Please answer based on how you have felt in the **past 7 days**, not just today."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "care_stage",
            "prompt": {
              "en": "Where are you in your care journey at the moment?"
            }
          },
          {
            "variable": "weeks_since_birth",
            "prompt": {
              "en": "If your baby has already been born, how many weeks ago was that?"
            },
            "hint": { "en": "Leave blank if you are still pregnant." }
          },
          {
            "variable": "living_situation",
            "prompt": {
              "en": "Which best describes who you live with right now?"
            }
          },
          {
            "variable": "epds_1",
            "prompt": {
              "en": "In the past 7 days: I have been able to laugh and see the funny side of things."
            }
          },
          {
            "variable": "epds_2",
            "prompt": {
              "en": "In the past 7 days: I have looked forward with enjoyment to things."
            }
          },
          {
            "variable": "epds_3",
            "prompt": {
              "en": "In the past 7 days: I have blamed myself unnecessarily when things went wrong."
            }
          },
          {
            "variable": "epds_4",
            "prompt": {
              "en": "In the past 7 days: I have been anxious or worried for no good reason."
            }
          },
          {
            "variable": "epds_5",
            "prompt": {
              "en": "In the past 7 days: I have felt scared or panicky for no very good reason."
            }
          },
          {
            "variable": "epds_6",
            "prompt": {
              "en": "In the past 7 days: Things have been getting on top of me."
            }
          },
          {
            "variable": "epds_7",
            "prompt": {
              "en": "In the past 7 days: I have been so unhappy that I have had difficulty sleeping."
            }
          },
          {
            "variable": "epds_8",
            "prompt": {
              "en": "In the past 7 days: I have felt sad or miserable."
            }
          },
          {
            "variable": "epds_9",
            "prompt": {
              "en": "In the past 7 days: I have been so unhappy that I have been crying."
            }
          },
          {
            "variable": "epds_10",
            "prompt": {
              "en": "In the past 7 days: The thought of harming myself has occurred to me."
            }
          }
        ]
      }
    },
    {
      "id": "ng-support-functions",
      "dynamicValues": {
        "careStage": {
          "path": "ego.care_stage",
          "cases": { "pregnant": "pregnant", "postpartum": "postpartum" }
        }
      },
      "type": "NameGenerator",
      "label": { "en": "People who support you" },
      "interviewScript": "Use these prompts in turn. The same person can be named under more than one prompt. Functions that no one is named for are meaningful: they may indicate a support gap to explore with the participant.",
      "panels": [
        {
          "id": "ng-support-functions-existing",
          "title": { "en": "Already mentioned" },
          "dataSource": "existing"
        }
      ],
      "subject": { "entity": "node", "type": "supporter" },
      "form": {
        "title": { "en": "Add Supporter" },
        "fields": [
          {
            "variable": "supporter_name",
            "prompt": { "en": "What is this person's name or initials?" },
            "hint": { "en": "Use whatever helps you remember who they are." }
          }
        ]
      },
      "prompts": [
        {
          "id": "p-emotional",
          "text": {
            "en": "Who gives you **emotional support** — the people you can talk to, who listen and make you feel cared for?"
          }
        },
        {
          "id": "p-informational",
          "text": {
            "en": "Who do you turn to for **information or advice** about {careStage, select, missing {your pregnancy or the baby} pregnant {your pregnancy} postpartum {the baby} other {your pregnancy or the baby}}?"
          }
        },
        {
          "id": "p-practical",
          "text": {
            "en": "Who helps you with **practical tasks or childcare** — things like meals, errands, housework, or {careStage, select, missing {looking after the baby} pregnant {getting ready for the baby} postpartum {looking after the baby} other {looking after the baby}}?"
          }
        },
        {
          "id": "p-financial",
          "text": {
            "en": "Who provides **financial help** — money, or paying for things you need for yourself or the baby?"
          }
        }
      ]
    },
    {
      "id": "bin-formal-informal",
      "type": "CategoricalBin",
      "label": { "en": "Formal or informal sources" },
      "subject": { "entity": "node", "type": "supporter" },
      "prompts": [
        {
          "id": "p-formal-informal",
          "text": {
            "en": "For each person, is their support **informal** (family, friends, other parents) or **formal / professional** (a clinician, doula, home-visiting nurse, or community health worker)?"
          },
          "variable": "formal_informal"
        }
      ]
    },
    {
      "id": "alter-support-detail-introduction",
      "type": "Information",
      "label": { "en": "A little more about each person" },
      "title": { "en": "A little more about each person" },
      "items": [
        {
          "id": "introduction-text",
          "type": "text",
          "content": {
            "en": "For each person you named, we'll ask a few short questions about where they are, how often you're in contact, and the kinds of support they give you."
          }
        }
      ]
    },
    {
      "id": "alter-support-detail",
      "dynamicValues": { "nodeLabel": { "path": "node.$label" } },
      "type": "AlterForm",
      "label": { "en": "About each supporter" },
      "subject": { "entity": "node", "type": "supporter" },
      "form": {
        "fields": [
          {
            "variable": "relationship",
            "prompt": { "en": "What is {nodeLabel}'s relationship to you?" }
          },
          {
            "variable": "proximity",
            "prompt": {
              "en": "Where is {nodeLabel}, relative to you, most of the time?"
            }
          },
          {
            "variable": "contact_frequency",
            "prompt": {
              "en": "How often are you in contact with {nodeLabel} at the moment?"
            }
          },
          {
            "variable": "support_functions",
            "prompt": {
              "en": "Which kinds of support does {nodeLabel} give you?"
            },
            "hint": { "en": "Select all that apply." }
          }
        ]
      }
    },
    {
      "id": "bin-reliance",
      "dynamicValues": {
        "careStage": {
          "path": "ego.care_stage",
          "cases": { "pregnant": "pregnant", "postpartum": "postpartum" }
        }
      },
      "type": "OrdinalBin",
      "label": { "en": "How much you rely on each person" },
      "subject": { "entity": "node", "type": "supporter" },
      "prompts": [
        {
          "id": "p-reliance",
          "text": {
            "en": "Thinking about {careStage, select, missing {your care and the baby} pregnant {your pregnancy} postpartum {your care and the baby} other {your care and the baby}}, **how much do you rely on each person** for support overall? Drag each person into the band that fits best."
          },
          "variable": "reliance",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "narrative-support-map",
      "groupsHeading": { "en": "Groups" },
      "type": "Narrative",
      "label": { "en": "Your support map" },
      "subject": { "entity": "node", "type": "supporter" },
      "behaviours": {
        "automaticLayout": true,
        "allowRepositioning": true,
        "freeDraw": true
      },
      "presets": [
        {
          "id": "preset-by-source",
          "label": { "en": "Support map by source (formal vs informal)" },
          "layoutVariable": "layout",
          "groupVariable": "formal_informal",
          "highlight": []
        }
      ],
      "background": { "concentricCircles": 3, "skewedTowardCenter": true }
    },
    {
      "id": "finish",
      "finishLabel": { "en": "Finish" },
      "finishConfirmation": {
        "en": "Are you sure you want to finish the interview?"
      },
      "finishFailed": {
        "en": "The interview could not be finished. Please try again. If the problem continues, contact the study organizer."
      },
      "type": "FinishSession",
      "mode": "confirmation",
      "label": { "en": "Finish Interview" },
      "content": {
        "en": "# Finish Interview\n\nYou have reached the end of the interview. If you are satisfied with the information you have entered, you may finish the interview now."
      },
      "finishedContent": {
        "en": "# Interview Finished\n\nThank you for participating!"
      },
      "outcome": "completed"
    }
  ],
