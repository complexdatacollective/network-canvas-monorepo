{
  "name": "Care & Support Networks",
  "description": "An example of a study that looks at who supports a participant through a period of care, and the kinds of support they provide — emotional, practical, informational, and financial — across both informal and professional sources. Configured here for the perinatal period (pregnancy and new parenthood).",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en-US", "locales": ["en-US"] },
  "lastModified": "2026-06-15T00:00:00.000Z",
  "codebook": {
    "ego": {
      "variables": {
        "care_stage": {
          "name": "care_stage",
          "label": "care_stage",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            { "label": { "en-US": "Pregnant" }, "value": "pregnant" },
            {
              "label": { "en-US": "Postpartum (baby already born)" },
              "value": "postpartum"
            }
          ],
          "validation": { "required": true }
        },
        "weeks_since_birth": {
          "name": "weeks_since_birth",
          "label": "weeks_since_birth",
          "type": "number",
          "component": "Number",
          "validation": { "minValue": 0, "maxValue": 104 }
        },
        "living_situation": {
          "name": "living_situation",
          "label": "living_situation",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            {
              "label": { "en-US": "Living with a partner / spouse" },
              "value": "with_partner"
            },
            {
              "label": { "en-US": "Living with other family or relatives" },
              "value": "with_family"
            },
            {
              "label": { "en-US": "Living with friends or housemates" },
              "value": "with_others"
            },
            { "label": { "en-US": "Living alone" }, "value": "alone" }
          ]
        },
        "epds_1": {
          "name": "epds_1",
          "label": "epds_1",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "As much as I always could" }, "value": 0 },
            { "label": { "en-US": "Not quite so much now" }, "value": 1 },
            { "label": { "en-US": "Definitely not so much now" }, "value": 2 },
            { "label": { "en-US": "Not at all" }, "value": 3 }
          ]
        },
        "epds_2": {
          "name": "epds_2",
          "label": "epds_2",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "As much as I ever did" }, "value": 0 },
            { "label": { "en-US": "Rather less than I used to" }, "value": 1 },
            {
              "label": { "en-US": "Definitely less than I used to" },
              "value": 2
            },
            { "label": { "en-US": "Hardly at all" }, "value": 3 }
          ]
        },
        "epds_3": {
          "name": "epds_3",
          "label": "epds_3",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Yes, most of the time" }, "value": 3 },
            { "label": { "en-US": "Yes, some of the time" }, "value": 2 },
            { "label": { "en-US": "Not very often" }, "value": 1 },
            { "label": { "en-US": "No, never" }, "value": 0 }
          ]
        },
        "epds_4": {
          "name": "epds_4",
          "label": "epds_4",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "No, not at all" }, "value": 0 },
            { "label": { "en-US": "Hardly ever" }, "value": 1 },
            { "label": { "en-US": "Yes, sometimes" }, "value": 2 },
            { "label": { "en-US": "Yes, very often" }, "value": 3 }
          ]
        },
        "epds_5": {
          "name": "epds_5",
          "label": "epds_5",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Yes, quite a lot" }, "value": 3 },
            { "label": { "en-US": "Yes, sometimes" }, "value": 2 },
            { "label": { "en-US": "No, not much" }, "value": 1 },
            { "label": { "en-US": "No, not at all" }, "value": 0 }
          ]
        },
        "epds_6": {
          "name": "epds_6",
          "label": "epds_6",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            {
              "label": {
                "en-US": "Yes, most of the time I haven't been able to cope at all"
              },
              "value": 3
            },
            {
              "label": {
                "en-US": "Yes, sometimes I haven't been coping as well as usual"
              },
              "value": 2
            },
            {
              "label": {
                "en-US": "No, most of the time I have coped quite well"
              },
              "value": 1
            },
            {
              "label": { "en-US": "No, I have been coping as well as ever" },
              "value": 0
            }
          ]
        },
        "epds_7": {
          "name": "epds_7",
          "label": "epds_7",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Yes, most of the time" }, "value": 3 },
            { "label": { "en-US": "Yes, sometimes" }, "value": 2 },
            { "label": { "en-US": "Not very often" }, "value": 1 },
            { "label": { "en-US": "No, not at all" }, "value": 0 }
          ]
        },
        "epds_8": {
          "name": "epds_8",
          "label": "epds_8",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Yes, most of the time" }, "value": 3 },
            { "label": { "en-US": "Yes, quite often" }, "value": 2 },
            { "label": { "en-US": "Not very often" }, "value": 1 },
            { "label": { "en-US": "No, not at all" }, "value": 0 }
          ]
        },
        "epds_9": {
          "name": "epds_9",
          "label": "epds_9",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Yes, most of the time" }, "value": 3 },
            { "label": { "en-US": "Yes, quite often" }, "value": 2 },
            { "label": { "en-US": "Only occasionally" }, "value": 1 },
            { "label": { "en-US": "No, never" }, "value": 0 }
          ]
        },
        "epds_10": {
          "name": "epds_10",
          "label": "epds_10",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Yes, quite often" }, "value": 3 },
            { "label": { "en-US": "Sometimes" }, "value": 2 },
            { "label": { "en-US": "Hardly ever" }, "value": 1 },
            { "label": { "en-US": "Never" }, "value": 0 }
          ]
        }
      }
    },
    "node": {
      "supporter": {
        "name": "Supporter",
        "label": { "en-US": "Supporter" },
        "color": "node-color-seq-1",
        "icon": "add-a-person",
        "shape": { "default": "circle" },
        "variables": {
          "supporter_name": {
            "name": "supporter_name",
            "label": "supporter_name",
            "type": "text",
            "component": "Text",
            "validation": { "required": true, "unique": true }
          },
          "relationship": {
            "name": "relationship",
            "label": "relationship",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en-US": "Partner or spouse" }, "value": "partner" },
              {
                "label": { "en-US": "Parent or parent-in-law" },
                "value": "parent"
              },
              {
                "label": { "en-US": "Other family member" },
                "value": "family"
              },
              { "label": { "en-US": "Friend" }, "value": "friend" },
              {
                "label": { "en-US": "Another parent / peer" },
                "value": "peer_parent"
              },
              { "label": { "en-US": "Neighbour" }, "value": "neighbour" },
              {
                "label": { "en-US": "Healthcare or service provider" },
                "value": "provider"
              }
            ]
          },
          "formal_informal": {
            "name": "formal_informal",
            "label": "formal_informal",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              {
                "label": { "en-US": "Informal (family, friends, peers)" },
                "value": "informal"
              },
              {
                "label": {
                  "en-US": "Formal or professional (clinician, doula, home-visiting nurse, community health worker)"
                },
                "value": "formal"
              }
            ]
          },
          "support_functions": {
            "name": "support_functions",
            "label": "support_functions",
            "type": "categorical",
            "component": "CheckboxGroup",
            "options": [
              {
                "label": { "en-US": "Emotional support" },
                "value": "emotional"
              },
              {
                "label": { "en-US": "Information or advice" },
                "value": "informational"
              },
              {
                "label": { "en-US": "Practical help or childcare" },
                "value": "practical"
              },
              { "label": { "en-US": "Financial help" }, "value": "financial" }
            ],
            "validation": { "minSelected": 1 }
          },
          "proximity": {
            "name": "proximity",
            "label": "proximity",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              {
                "label": { "en-US": "Same household" },
                "value": "same_household"
              },
              { "label": { "en-US": "Nearby" }, "value": "nearby" },
              { "label": { "en-US": "Far away" }, "value": "far_away" },
              { "label": { "en-US": "Online only" }, "value": "online_only" }
            ]
          },
          "contact_frequency": {
            "name": "contact_frequency",
            "label": "contact_frequency",
            "type": "ordinal",
            "component": "RadioGroup",
            "options": [
              { "label": { "en-US": "Every day" }, "value": 5 },
              { "label": { "en-US": "A few times a week" }, "value": 4 },
              { "label": { "en-US": "About once a week" }, "value": 3 },
              { "label": { "en-US": "A few times a month" }, "value": 2 },
              { "label": { "en-US": "Less than once a month" }, "value": 1 }
            ]
          },
          "reliance": {
            "name": "reliance",
            "label": "reliance",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Not at all" }, "value": 1 },
              { "label": { "en-US": "A little" }, "value": 2 },
              { "label": { "en-US": "A moderate amount" }, "value": 3 },
              { "label": { "en-US": "A lot" }, "value": 4 },
              { "label": { "en-US": "Completely" }, "value": 5 }
            ]
          },
          "layout": {
            "name": "layout",
            "label": "layout",
            "type": "layout"
          }
        }
      }
    }
  },
  "stages": [
    {
      "id": "information-researcher-notes",
      "type": "Information",
      "label": { "en-US": "Template notes (delete before fielding)" },
      "title": { "en-US": "Template notes" },
      "items": [
        {
          "id": "researcher-notes",
          "type": "text",
          "content": {
            "en-US": "## For researchers\n\n_Delete this screen before you field the study._\n\n**Clinical safety:** the EPDS is a screening tool, not a diagnostic instrument. Item 10 screens for thoughts of self-harm, so before fielding put a safety protocol in place — interviewer training, an escalation pathway, and local crisis-line and referral details — for any participant who endorses item 10 or otherwise shows distress.\n\nThe instruments this template draws on:\n\n- [Cox JL, Holden JM, Sagovsky R (1987). Detection of postnatal depression: the 10-item Edinburgh Postnatal Depression Scale (EPDS). *Br J Psychiatry* 150:782–786.](https://pubmed.ncbi.nlm.nih.gov/3651732/)\n- [Sherbourne CD, Stewart AL (1991). The MOS Social Support Survey. *Soc Sci Med* 32(6):705–714.](https://www.rand.org/pubs/reprints/RP218.html)"
          }
        }
      ]
    },
    {
      "id": "information-intro",
      "type": "Information",
      "label": { "en-US": "Welcome" },
      "title": { "en-US": "About this study" },
      "items": [
        {
          "id": "intro-welcome",
          "type": "text",
          "content": {
            "en-US": "## Welcome\n\nThank you for taking part. In this interview we will talk about the **people who support you** during this period, and the kinds of help they provide. There are no right or wrong answers — we are interested in your own experience."
          }
        }
      ]
    },
    {
      "id": "ego-care-context",
      "type": "EgoForm",
      "label": { "en-US": "About you and your care episode" },
      "interviewScript": "Clinical safety: EPDS item 10 screens for thoughts of self-harm. Before fielding this protocol, put a safety protocol in place — interviewer training, an escalation pathway, and local crisis-line / referral details — for any participant who endorses item 10 or otherwise shows distress. The software records responses but does not act on them.",
      "introductionPanel": {
        "title": { "en-US": "About you right now" },
        "text": {
          "en-US": "First, a few questions about where you are in your care journey, and how you have been feeling.\n\nThe questions about your mood come from the **Edinburgh Postnatal Depression Scale (EPDS)**. There are no right or wrong answers. Please answer based on how you have felt in the **past 7 days**, not just today."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "care_stage",
            "prompt": {
              "en-US": "Where are you in your care journey at the moment?"
            }
          },
          {
            "variable": "weeks_since_birth",
            "prompt": {
              "en-US": "If your baby has already been born, how many weeks ago was that?"
            },
            "hint": { "en-US": "Leave blank if you are still pregnant." }
          },
          {
            "variable": "living_situation",
            "prompt": {
              "en-US": "Which best describes who you live with right now?"
            }
          },
          {
            "variable": "epds_1",
            "prompt": {
              "en-US": "In the past 7 days: I have been able to laugh and see the funny side of things."
            }
          },
          {
            "variable": "epds_2",
            "prompt": {
              "en-US": "In the past 7 days: I have looked forward with enjoyment to things."
            }
          },
          {
            "variable": "epds_3",
            "prompt": {
              "en-US": "In the past 7 days: I have blamed myself unnecessarily when things went wrong."
            }
          },
          {
            "variable": "epds_4",
            "prompt": {
              "en-US": "In the past 7 days: I have been anxious or worried for no good reason."
            }
          },
          {
            "variable": "epds_5",
            "prompt": {
              "en-US": "In the past 7 days: I have felt scared or panicky for no very good reason."
            }
          },
          {
            "variable": "epds_6",
            "prompt": {
              "en-US": "In the past 7 days: Things have been getting on top of me."
            }
          },
          {
            "variable": "epds_7",
            "prompt": {
              "en-US": "In the past 7 days: I have been so unhappy that I have had difficulty sleeping."
            }
          },
          {
            "variable": "epds_8",
            "prompt": {
              "en-US": "In the past 7 days: I have felt sad or miserable."
            }
          },
          {
            "variable": "epds_9",
            "prompt": {
              "en-US": "In the past 7 days: I have been so unhappy that I have been crying."
            }
          },
          {
            "variable": "epds_10",
            "prompt": {
              "en-US": "In the past 7 days: The thought of harming myself has occurred to me."
            }
          }
        ]
      }
    },
    {
      "id": "ng-support-functions",
      "type": "NameGenerator",
      "label": { "en-US": "People who support you" },
      "interviewScript": "Use these prompts in turn. The same person can be named under more than one prompt. Functions that no one is named for are meaningful: they may indicate a support gap to explore with the participant.",
      "panels": [
        {
          "id": "ng-support-functions-existing",
          "title": { "en-US": "Already mentioned" },
          "dataSource": "existing"
        }
      ],
      "subject": { "entity": "node", "type": "supporter" },
      "form": {
        "title": { "en-US": "Add Supporter" },
        "fields": [
          {
            "variable": "supporter_name",
            "prompt": { "en-US": "What is this person's name or initials?" },
            "hint": { "en-US": "Use whatever helps you remember who they are." }
          }
        ]
      },
      "prompts": [
        {
          "id": "p-emotional",
          "text": {
            "en-US": "Who gives you **emotional support** — the people you can talk to, who listen and make you feel cared for?"
          }
        },
        {
          "id": "p-informational",
          "text": {
            "en-US": "Who do you turn to for **information or advice** about your pregnancy or the baby?"
          }
        },
        {
          "id": "p-practical",
          "text": {
            "en-US": "Who helps you with **practical tasks or childcare** — things like meals, errands, housework, or looking after the baby?"
          }
        },
        {
          "id": "p-financial",
          "text": {
            "en-US": "Who provides **financial help** — money, or paying for things you need for yourself or the baby?"
          }
        }
      ]
    },
    {
      "id": "bin-formal-informal",
      "type": "CategoricalBin",
      "label": { "en-US": "Formal or informal sources" },
      "subject": { "entity": "node", "type": "supporter" },
      "prompts": [
        {
          "id": "p-formal-informal",
          "text": {
            "en-US": "For each person, is their support **informal** (family, friends, other parents) or **formal / professional** (a clinician, doula, home-visiting nurse, or community health worker)?"
          },
          "variable": "formal_informal"
        }
      ]
    },
    {
      "id": "alter-support-detail",
      "type": "AlterForm",
      "label": { "en-US": "About each supporter" },
      "subject": { "entity": "node", "type": "supporter" },
      "introductionPanel": {
        "title": { "en-US": "A little more about each person" },
        "text": {
          "en-US": "For each person you named, we'll ask a few short questions about where they are, how often you're in contact, and the kinds of support they give you."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "relationship",
            "prompt": { "en-US": "What is this person's relationship to you?" }
          },
          {
            "variable": "proximity",
            "prompt": {
              "en-US": "Where is this person, relative to you, most of the time?"
            }
          },
          {
            "variable": "contact_frequency",
            "prompt": {
              "en-US": "How often are you in contact with this person at the moment?"
            }
          },
          {
            "variable": "support_functions",
            "prompt": {
              "en-US": "Which kinds of support does this person give you?"
            },
            "hint": { "en-US": "Select all that apply." }
          }
        ]
      }
    },
    {
      "id": "bin-reliance",
      "type": "OrdinalBin",
      "label": { "en-US": "How much you rely on each person" },
      "subject": { "entity": "node", "type": "supporter" },
      "prompts": [
        {
          "id": "p-reliance",
          "text": {
            "en-US": "Thinking about your care and the baby, **how much do you rely on each person** for support overall? Drag each person into the band that fits best."
          },
          "variable": "reliance",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "narrative-support-map",
      "type": "Narrative",
      "label": { "en-US": "Your support map" },
      "subject": { "entity": "node", "type": "supporter" },
      "behaviours": {
        "automaticLayout": true,
        "allowRepositioning": true,
        "freeDraw": true
      },
      "presets": [
        {
          "id": "preset-by-source",
          "label": { "en-US": "Support map by source (formal vs informal)" },
          "layoutVariable": "layout",
          "groupVariable": "formal_informal",
          "highlight": []
        }
      ],
      "background": {
        "concentricCircles": 3,
        "skewedTowardCenter": true
      }
    },
    {
      "id": "finish",
      "type": "FinishSession",
      "label": {
        "en-US": "Finish Interview"
      },
      "title": {
        "en-US": "Finish Interview"
      },
      "content": {
        "en-US": "You have reached the end of the interview. If you are satisfied with the information you have entered, you may finish the interview now."
      },
      "outcome": "completed"
    }
  ]
}
