{
  "name": "Behavioural Influence Networks",
  "description": "An example template for studying social influence on health behaviours such as smoking, vaping, physical activity, diet, and alcohol use. It uses behaviour-specific name generators to elicit the people a participant shares each behaviour with, alongside the participant's own self-report.",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en-US", "locales": ["en-US"] },
  "lastModified": "2026-06-15T00:00:00.000Z",
  "codebook": {
    "ego": {
      "variables": {
        "activity_minutes_week": {
          "name": "activity_minutes_week",
          "label": "activity_minutes_week",
          "type": "number",
          "component": "Number",
          "validation": {
            "minValue": 0,
            "maxValue": 10080
          }
        },
        "smoking_status": {
          "name": "smoking_status",
          "label": "smoking_status",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            {
              "label": {
                "en-US": "Current smoker (smoke every day or some days)"
              },
              "value": "current"
            },
            {
              "label": {
                "en-US": "Former smoker (smoked at least 100 cigarettes in my life, but not now)"
              },
              "value": "former"
            },
            {
              "label": {
                "en-US": "Never smoker (have not smoked 100 cigarettes in my life)"
              },
              "value": "never"
            }
          ],
          "validation": {
            "required": true
          }
        },
        "vaping_status": {
          "name": "vaping_status",
          "label": "vaping_status",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            { "label": { "en-US": "I vape every day" }, "value": "daily" },
            { "label": { "en-US": "I vape some days" }, "value": "some_days" },
            {
              "label": { "en-US": "I have tried vaping, but not now" },
              "value": "former"
            },
            { "label": { "en-US": "I have never vaped" }, "value": "never" }
          ],
          "validation": {
            "required": true
          }
        },
        "diet_quality": {
          "name": "diet_quality",
          "label": "diet_quality",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Poor" }, "value": 1 },
            { "label": { "en-US": "Fair" }, "value": 2 },
            { "label": { "en-US": "Good" }, "value": 3 },
            { "label": { "en-US": "Very good" }, "value": 4 },
            { "label": { "en-US": "Excellent" }, "value": 5 }
          ],
          "validation": {
            "required": true
          }
        },
        "alcohol_frequency": {
          "name": "alcohol_frequency",
          "label": "alcohol_frequency",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en-US": "Never" }, "value": 0 },
            { "label": { "en-US": "Monthly or less" }, "value": 1 },
            { "label": { "en-US": "2 to 4 times a month" }, "value": 2 },
            { "label": { "en-US": "2 to 3 times a week" }, "value": 3 },
            { "label": { "en-US": "4 or more times a week" }, "value": 4 }
          ],
          "validation": {
            "required": true
          }
        }
      }
    },
    "node": {
      "person": {
        "name": "Person",
        "label": { "en-US": "Person" },
        "color": "node-color-seq-1",
        "icon": "add-a-person",
        "shape": { "default": "circle" },
        "variables": {
          "alter_name": {
            "name": "alter_name",
            "label": "alter_name",
            "type": "text",
            "component": "Text",
            "validation": {
              "required": true,
              "unique": true
            }
          },
          "relationship": {
            "name": "relationship",
            "label": "relationship",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en-US": "Partner or spouse" }, "value": "partner" },
              { "label": { "en-US": "Family member" }, "value": "family" },
              { "label": { "en-US": "Friend" }, "value": "friend" },
              {
                "label": { "en-US": "Co-worker or classmate" },
                "value": "coworker"
              },
              { "label": { "en-US": "Neighbour" }, "value": "neighbour" },
              { "label": { "en-US": "Other" }, "value": "other" }
            ]
          },
          "closeness": {
            "name": "closeness",
            "label": "closeness",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Not close" }, "value": 1 },
              { "label": { "en-US": "Somewhat close" }, "value": 2 },
              { "label": { "en-US": "Close" }, "value": 3 },
              { "label": { "en-US": "Very close" }, "value": 4 }
            ]
          },
          "alter_smokes": {
            "name": "alter_smokes",
            "label": "alter_smokes",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en-US": "Yes" }, "value": "yes" },
              { "label": { "en-US": "No" }, "value": "no" },
              { "label": { "en-US": "Don't know" }, "value": "dont_know" }
            ]
          },
          "alter_activity": {
            "name": "alter_activity",
            "label": "alter_activity",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Not at all active" }, "value": 1 },
              { "label": { "en-US": "Slightly active" }, "value": 2 },
              { "label": { "en-US": "Moderately active" }, "value": 3 },
              { "label": { "en-US": "Very active" }, "value": 4 }
            ]
          },
          "alter_diet": {
            "name": "alter_diet",
            "label": "alter_diet",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en-US": "Poor" }, "value": 1 },
              { "label": { "en-US": "Fair" }, "value": 2 },
              { "label": { "en-US": "Good" }, "value": 3 },
              { "label": { "en-US": "Very good" }, "value": 4 },
              { "label": { "en-US": "Excellent" }, "value": 5 }
            ]
          },
          "alter_drinks": {
            "name": "alter_drinks",
            "label": "alter_drinks",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en-US": "Never" }, "value": "never" },
              { "label": { "en-US": "Monthly or less" }, "value": "monthly" },
              { "label": { "en-US": "Weekly" }, "value": "weekly" },
              { "label": { "en-US": "Most days" }, "value": "most_days" },
              { "label": { "en-US": "Don't know" }, "value": "dont_know" }
            ]
          },
          "shared_domains": {
            "name": "shared_domains",
            "label": "shared_domains",
            "type": "categorical",
            "component": "CheckboxGroup",
            "options": [
              {
                "label": { "en-US": "Exercise together" },
                "value": "exercise"
              },
              { "label": { "en-US": "Eat meals together" }, "value": "meals" },
              {
                "label": { "en-US": "Smoke or vape together" },
                "value": "smoke_vape"
              },
              {
                "label": { "en-US": "Drink alcohol together" },
                "value": "drink"
              }
            ],
            "validation": {
              "minSelected": 1
            }
          },
          "layout": {
            "name": "layout",
            "label": "layout",
            "type": "layout"
          }
        }
      }
    },
    "edge": {
      "knows": {
        "name": "Knows",
        "label": { "en-US": "Knows" },
        "color": "edge-color-seq-1"
      }
    }
  },
  "stages": [
    {
      "id": "information-researcher-notes",
      "type": "Information",
      "label": { "en-US": "Template notes (delete before fielding)" },
      "title": { "en-US": "Template notes" },
      "items": [
        {
          "id": "researcher-notes",
          "type": "text",
          "content": {
            "en-US": "## For researchers\n\n_Delete this screen before you field the study._\n\n**Caveat:** behaviours shared among contacts reflect both social influence **and** homophily (selecting similar friends); this design cannot by itself separate the two.\n\nThe instruments and studies this template draws on:\n\n- [Christakis NA, Fowler JH (2007). The Spread of Obesity in a Large Social Network over 32 Years. *NEJM*.](https://www.albany.edu/~ravi/pdfs/christakis_fowler_2007.pdf)\n- [Christakis NA, Fowler JH (2008). The Collective Dynamics of Smoking in a Large Social Network. *NEJM*.](https://www.nejm.org/doi/full/10.1056/NEJMsa0706154)\n- [International Physical Activity Questionnaire (IPAQ) — PhenX Toolkit protocol.](https://www.phenxtoolkit.org/protocols/view/661901)\n- [Separating influence from homophily in network dynamics (SIENA / stochastic actor-based models).](https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3469361/)"
          }
        }
      ]
    },
    {
      "id": "information-intro",
      "type": "Information",
      "label": { "en-US": "Welcome" },
      "title": { "en-US": "About this study" },
      "items": [
        {
          "id": "intro-welcome",
          "type": "text",
          "content": {
            "en-US": "## Welcome\n\nThank you for taking part. In this interview we will talk about some of your everyday **health behaviours** and the **people you spend time with**. There are no right or wrong answers — we are interested in your own experience."
          }
        }
      ]
    },
    {
      "id": "ego-behaviours",
      "type": "EgoForm",
      "label": { "en-US": "Your own behaviours" },
      "introductionPanel": {
        "title": { "en-US": "About you" },
        "text": {
          "en-US": "First, a few questions about **your own** everyday behaviours. There are no right or wrong answers. Your responses give us a reference point for understanding the people you will tell us about later."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "activity_minutes_week",
            "prompt": {
              "en-US": "In a usual week, about how many **minutes** do you spend being physically active at a moderate or vigorous level?"
            },
            "hint": {
              "en-US": "Count activities that make you breathe harder than normal, in sessions of at least 10 minutes."
            }
          },
          {
            "variable": "smoking_status",
            "prompt": {
              "en-US": "Which best describes your **cigarette smoking**?"
            }
          },
          {
            "variable": "vaping_status",
            "prompt": {
              "en-US": "Which best describes your use of **e-cigarettes or vapes**?"
            }
          },
          {
            "variable": "diet_quality",
            "prompt": {
              "en-US": "In general, how healthy would you say your **diet** is?"
            }
          },
          {
            "variable": "alcohol_frequency",
            "prompt": {
              "en-US": "How often do you have a drink containing **alcohol**?"
            }
          }
        ]
      }
    },
    {
      "id": "ng-behaviours",
      "type": "NameGenerator",
      "label": { "en-US": "People you share behaviours with" },
      "interviewScript": "Each prompt asks about a different shared activity. The same person can take part in several of these activities; when they do, add them once and then select them from the panel of people already mentioned for the other prompts, rather than typing their name again.",
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "form": {
        "title": { "en-US": "Add Person" },
        "fields": [
          {
            "variable": "alter_name",
            "prompt": {
              "en-US": "What is this person's first name or a nickname you will recognise?"
            }
          }
        ]
      },
      "panels": [
        {
          "id": "already-mentioned",
          "title": { "en-US": "People you already mentioned" },
          "dataSource": "existing"
        }
      ],
      "prompts": [
        {
          "id": "p-exercise",
          "text": {
            "en-US": "Who are the people you usually **exercise or play sport with**?"
          }
        },
        {
          "id": "p-meals",
          "text": {
            "en-US": "Who are the people you usually **eat meals with**?"
          }
        },
        {
          "id": "p-smoke-vape",
          "text": {
            "en-US": "Who are the people you usually **smoke or vape with**?"
          }
        },
        {
          "id": "p-drink",
          "text": {
            "en-US": "Who are the people you usually **drink alcohol with**?"
          }
        }
      ]
    },
    {
      "id": "alter-behaviours",
      "type": "AlterForm",
      "label": { "en-US": "Their behaviours" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "introductionPanel": {
        "title": { "en-US": "About each person" },
        "text": {
          "en-US": "Now we will ask about **each person's own** behaviours, as far as you know them. If you are unsure, give your best impression or choose \"Don't know\"."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "shared_domains",
            "prompt": {
              "en-US": "Which of these activities do you ever do **with this person**?"
            },
            "hint": { "en-US": "Select all that apply." }
          },
          {
            "variable": "relationship",
            "prompt": { "en-US": "What is your relationship to this person?" }
          },
          {
            "variable": "alter_smokes",
            "prompt": {
              "en-US": "As far as you know, does this person **smoke**?"
            }
          },
          {
            "variable": "alter_activity",
            "prompt": {
              "en-US": "How **physically active** would you say this person is?"
            }
          },
          {
            "variable": "alter_diet",
            "prompt": {
              "en-US": "How **healthy** would you say this person's diet is?"
            }
          },
          {
            "variable": "alter_drinks",
            "prompt": {
              "en-US": "How often does this person **drink alcohol**, as far as you know?"
            }
          }
        ]
      }
    },
    {
      "id": "ordbin-closeness",
      "type": "OrdinalBin",
      "label": { "en-US": "How close you are" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "p-closeness",
          "text": {
            "en-US": "Place each person by **how close you feel to them**. Closer ties tend to have a stronger influence on our behaviour."
          },
          "variable": "closeness",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "narrative-clustering",
      "type": "Narrative",
      "label": { "en-US": "Review behavioural clustering" },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "behaviours": {
        "automaticLayout": true,
        "allowRepositioning": true,
        "freeDraw": true
      },
      "presets": [
        {
          "id": "preset-smoking",
          "label": { "en-US": "Smoking" },
          "layoutVariable": "layout",
          "groupVariable": "alter_smokes",
          "highlight": []
        },
        {
          "id": "preset-activity",
          "label": { "en-US": "Physical activity" },
          "layoutVariable": "layout",
          "groupVariable": "alter_activity",
          "highlight": []
        },
        {
          "id": "preset-drinking",
          "label": { "en-US": "Drinking" },
          "layoutVariable": "layout",
          "groupVariable": "alter_drinks",
          "highlight": []
        }
      ],
      "background": {
        "concentricCircles": 3,
        "skewedTowardCenter": true
      }
    },
    {
      "id": "finish",
      "finishLabel": {
        "en-US": "Finish"
      },
      "finishConfirmation": {
        "en-US": "Are you sure you want to finish the interview?"
      },
      "finishedNotice": {
        "en-US": "This interview is finished, and its answers can no longer be changed."
      },
      "finishFailed": {
        "en-US": "The interview could not be finished. Please try again. If the problem continues, contact the study organizer."
      },
      "type": "FinishSession",
      "label": {
        "en-US": "Finish Interview"
      },
      "title": {
        "en-US": "Finish Interview"
      },
      "content": {
        "en-US": "You have reached the end of the interview. If you are satisfied with the information you have entered, you may finish the interview now."
      },
      "outcome": "completed"
    }
  ],
  "interfaceText": {
    "interview": {
      "exitInterview": {
        "en-US": "Exit interview"
      },
      "exitInterviewDescription": {
        "en-US": "Your answers so far will be saved and you can continue later."
      },
      "stageError": {
        "en-US": "There was an error with the interview software, and this task could not be displayed. Some tasks, such as maps, need an internet connection, so check your connection and then try refreshing the page. If the problem persists, please contact the study organizer and send them the debug information, which you can copy with the button below. You may be able to continue your interview by clicking the next button."
      },
      "itemUnavailable": {
        "en-US": "This item could not be displayed."
      },
      "back": {
        "en-US": "Back"
      },
      "continue": {
        "en-US": "Continue"
      },
      "cancel": {
        "en-US": "Cancel"
      },
      "done": {
        "en-US": "Done"
      },
      "delete": {
        "en-US": "Delete"
      },
      "genericError": {
        "en-US": "Something went wrong."
      }
    },
    "forms": {
      "discardChanges": {
        "en-US": "Discard changes"
      },
      "discardChangesTitle": {
        "en-US": "Discard changes?"
      },
      "discardChangesDescription": {
        "en-US": "This form contains invalid data, so it cannot be saved. If you continue it will be reset, and your changes will be lost. Do you want to discard your changes?"
      },
      "yes": {
        "en-US": "Yes"
      },
      "no": {
        "en-US": "No"
      },
      "submitFailed": {
        "en-US": "An error occurred while submitting the form."
      }
    },
    "validation": {
      "required": {
        "en-US": "You must answer this question before continuing."
      },
      "minValue": {
        "en-US": "Enter a value greater than or equal to {min}."
      },
      "maxValue": {
        "en-US": "Enter a value less than or equal to {max}."
      },
      "minSelected": {
        "en-US": "{count, plural, one {Select at least # value.} other {Select at least # values.}}"
      },
      "unique": {
        "en-US": "Must be unique."
      }
    }
  }
}
