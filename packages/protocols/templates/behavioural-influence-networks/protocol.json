{
  "name": "Behavioural Influence Networks",
  "description": "An example template for studying social influence on health behaviours such as smoking, vaping, physical activity, diet, and alcohol use. It uses behaviour-specific name generators to elicit the people a participant shares each behaviour with, alongside the participant's own self-report.",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en", "locales": ["en"] },
  "lastModified": "2026-06-15T00:00:00.000Z",
  "codebook": {
    "ego": {
      "variables": {
        "activity_minutes_week": {
          "name": "activity_minutes_week",
          "type": "number",
          "component": "Number",
          "validation": { "minValue": 0, "maxValue": 10080 }
        },
        "smoking_status": {
          "name": "smoking_status",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            {
              "label": {
                "en": "Current smoker (smoke every day or some days)"
              },
              "value": "current"
            },
            {
              "label": {
                "en": "Former smoker (smoked at least 100 cigarettes in my life, but not now)"
              },
              "value": "former"
            },
            {
              "label": {
                "en": "Never smoker (have not smoked 100 cigarettes in my life)"
              },
              "value": "never"
            }
          ],
          "validation": { "required": true }
        },
        "vaping_status": {
          "name": "vaping_status",
          "type": "categorical",
          "component": "ToggleButtonGroup",
          "options": [
            { "label": { "en": "I vape every day" }, "value": "daily" },
            { "label": { "en": "I vape some days" }, "value": "some_days" },
            {
              "label": { "en": "I have tried vaping, but not now" },
              "value": "former"
            },
            { "label": { "en": "I have never vaped" }, "value": "never" }
          ],
          "validation": { "required": true }
        },
        "diet_quality": {
          "name": "diet_quality",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Poor" }, "value": 1 },
            { "label": { "en": "Fair" }, "value": 2 },
            { "label": { "en": "Good" }, "value": 3 },
            { "label": { "en": "Very good" }, "value": 4 },
            { "label": { "en": "Excellent" }, "value": 5 }
          ],
          "validation": { "required": true }
        },
        "alcohol_frequency": {
          "name": "alcohol_frequency",
          "type": "ordinal",
          "component": "LikertScale",
          "options": [
            { "label": { "en": "Never" }, "value": 0 },
            { "label": { "en": "Monthly or less" }, "value": 1 },
            { "label": { "en": "2 to 4 times a month" }, "value": 2 },
            { "label": { "en": "2 to 3 times a week" }, "value": 3 },
            { "label": { "en": "4 or more times a week" }, "value": 4 }
          ],
          "validation": { "required": true }
        }
      }
    },
    "node": {
      "person": {
        "name": "Person",
        "color": "node-color-seq-1",
        "icon": "add-a-person",
        "shape": { "default": "circle" },
        "variables": {
          "alter_name": {
            "name": "alter_name",
            "type": "text",
            "component": "Text",
            "validation": { "required": true, "unique": true }
          },
          "relationship": {
            "name": "relationship",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en": "Partner or spouse" }, "value": "partner" },
              { "label": { "en": "Family member" }, "value": "family" },
              { "label": { "en": "Friend" }, "value": "friend" },
              {
                "label": { "en": "Co-worker or classmate" },
                "value": "coworker"
              },
              { "label": { "en": "Neighbour" }, "value": "neighbour" },
              { "label": { "en": "Other" }, "value": "other" }
            ]
          },
          "closeness": {
            "name": "closeness",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Not close" }, "value": 1 },
              { "label": { "en": "Somewhat close" }, "value": 2 },
              { "label": { "en": "Close" }, "value": 3 },
              { "label": { "en": "Very close" }, "value": 4 }
            ]
          },
          "alter_smokes": {
            "name": "alter_smokes",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en": "Yes" }, "value": "yes" },
              { "label": { "en": "No" }, "value": "no" },
              { "label": { "en": "Don't know" }, "value": "dont_know" }
            ]
          },
          "alter_activity": {
            "name": "alter_activity",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Not at all active" }, "value": 1 },
              { "label": { "en": "Slightly active" }, "value": 2 },
              { "label": { "en": "Moderately active" }, "value": 3 },
              { "label": { "en": "Very active" }, "value": 4 }
            ]
          },
          "alter_diet": {
            "name": "alter_diet",
            "type": "ordinal",
            "component": "LikertScale",
            "options": [
              { "label": { "en": "Poor" }, "value": 1 },
              { "label": { "en": "Fair" }, "value": 2 },
              { "label": { "en": "Good" }, "value": 3 },
              { "label": { "en": "Very good" }, "value": 4 },
              { "label": { "en": "Excellent" }, "value": 5 }
            ]
          },
          "alter_drinks": {
            "name": "alter_drinks",
            "type": "categorical",
            "component": "ToggleButtonGroup",
            "options": [
              { "label": { "en": "Never" }, "value": "never" },
              { "label": { "en": "Monthly or less" }, "value": "monthly" },
              { "label": { "en": "Weekly" }, "value": "weekly" },
              { "label": { "en": "Most days" }, "value": "most_days" },
              { "label": { "en": "Don't know" }, "value": "dont_know" }
            ]
          },
          "shared_domains": {
            "name": "shared_domains",
            "type": "categorical",
            "component": "CheckboxGroup",
            "options": [
              {
                "label": { "en": "Exercise together" },
                "value": "exercise"
              },
              { "label": { "en": "Eat meals together" }, "value": "meals" },
              {
                "label": { "en": "Smoke or vape together" },
                "value": "smoke_vape"
              },
              {
                "label": { "en": "Drink alcohol together" },
                "value": "drink"
              }
            ],
            "validation": { "minSelected": 1 }
          },
          "layout": { "name": "layout", "type": "layout" }
        }
      }
    },
    "edge": { "knows": { "name": "Knows", "color": "edge-color-seq-1" } }
  },
  "stages": [
    {
      "id": "information-researcher-notes",
      "type": "Information",
      "label": { "en": "Template notes (delete before fielding)" },
      "title": { "en": "Template notes" },
      "items": [
        {
          "id": "researcher-notes",
          "type": "text",
          "content": {
            "en": "## For researchers\n\n_Delete this screen before you field the study._\n\n**Caveat:** behaviours shared among contacts reflect both social influence **and** homophily (selecting similar friends); this design cannot by itself separate the two.\n\nThe instruments and studies this template draws on:\n\n- [Christakis NA, Fowler JH (2007). The Spread of Obesity in a Large Social Network over 32 Years. *NEJM*.](https://www.albany.edu/~ravi/pdfs/christakis_fowler_2007.pdf)\n- [Christakis NA, Fowler JH (2008). The Collective Dynamics of Smoking in a Large Social Network. *NEJM*.](https://www.nejm.org/doi/full/10.1056/NEJMsa0706154)\n- [International Physical Activity Questionnaire (IPAQ) — PhenX Toolkit protocol.](https://www.phenxtoolkit.org/protocols/view/661901)\n- [Separating influence from homophily in network dynamics (SIENA / stochastic actor-based models).](https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3469361/)"
          }
        }
      ]
    },
    {
      "id": "information-intro",
      "type": "Information",
      "label": { "en": "Welcome" },
      "title": { "en": "About this study" },
      "items": [
        {
          "id": "intro-welcome",
          "type": "text",
          "content": {
            "en": "## Welcome\n\nThank you for taking part. In this interview we will talk about some of your everyday **health behaviours** and the **people you spend time with**. There are no right or wrong answers — we are interested in your own experience."
          }
        }
      ]
    },
    {
      "id": "ego-behaviours",
      "type": "EgoForm",
      "label": { "en": "Your own behaviours" },
      "introductionPanel": {
        "title": { "en": "About you" },
        "text": {
          "en": "First, a few questions about **your own** everyday behaviours. There are no right or wrong answers. Your responses give us a reference point for understanding the people you will tell us about later."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "activity_minutes_week",
            "prompt": {
              "en": "In a usual week, about how many **minutes** do you spend being physically active at a moderate or vigorous level?"
            },
            "hint": {
              "en": "Count activities that make you breathe harder than normal, in sessions of at least 10 minutes."
            }
          },
          {
            "variable": "smoking_status",
            "prompt": {
              "en": "Which best describes your **cigarette smoking**?"
            }
          },
          {
            "variable": "vaping_status",
            "prompt": {
              "en": "Which best describes your use of **e-cigarettes or vapes**?"
            }
          },
          {
            "variable": "diet_quality",
            "prompt": {
              "en": "In general, how healthy would you say your **diet** is?"
            }
          },
          {
            "variable": "alcohol_frequency",
            "prompt": {
              "en": "How often do you have a drink containing **alcohol**?"
            }
          }
        ]
      }
    },
    {
      "id": "ng-behaviours",
      "type": "NameGenerator",
      "label": { "en": "People you share behaviours with" },
      "interviewScript": "Each prompt asks about a different shared activity. The same person can take part in several of these activities; when they do, add them once and then select them from the panel of people already mentioned for the other prompts, rather than typing their name again.",
      "subject": { "entity": "node", "type": "person" },
      "form": {
        "title": { "en": "Add Person" },
        "fields": [
          {
            "variable": "alter_name",
            "prompt": {
              "en": "What is this person's first name or a nickname you will recognise?"
            }
          }
        ]
      },
      "panels": [
        {
          "id": "already-mentioned",
          "title": { "en": "People you already mentioned" },
          "dataSource": "existing"
        }
      ],
      "prompts": [
        {
          "id": "p-exercise",
          "text": {
            "en": "Who are the people you usually **exercise or play sport with**?"
          }
        },
        {
          "id": "p-meals",
          "text": {
            "en": "Who are the people you usually **eat meals with**?"
          }
        },
        {
          "id": "p-smoke-vape",
          "text": {
            "en": "Who are the people you usually **smoke or vape with**?"
          }
        },
        {
          "id": "p-drink",
          "text": {
            "en": "Who are the people you usually **drink alcohol with**?"
          }
        }
      ]
    },
    {
      "id": "alter-behaviours-introduction",
      "type": "Information",
      "label": { "en": "About each person" },
      "title": { "en": "About each person" },
      "items": [
        {
          "id": "introduction-text",
          "type": "text",
          "content": {
            "en": "Now we will ask about **each person's own** behaviours, as far as you know them. If you are unsure, give your best impression or choose \"Don't know\"."
          }
        }
      ]
    },
    {
      "id": "alter-behaviours",
      "dynamicValues": { "nodeLabel": { "path": "node.$label" } },
      "type": "AlterForm",
      "label": { "en": "Their behaviours" },
      "subject": { "entity": "node", "type": "person" },
      "form": {
        "fields": [
          {
            "variable": "shared_domains",
            "prompt": {
              "en": "Which of these activities do you ever do **with {nodeLabel}**?"
            },
            "hint": { "en": "Select all that apply." }
          },
          {
            "variable": "relationship",
            "prompt": { "en": "What is your relationship to {nodeLabel}?" }
          },
          {
            "variable": "alter_smokes",
            "prompt": {
              "en": "As far as you know, does {nodeLabel} **smoke**?"
            }
          },
          {
            "variable": "alter_activity",
            "prompt": {
              "en": "How **physically active** would you say {nodeLabel} is?"
            }
          },
          {
            "variable": "alter_diet",
            "prompt": {
              "en": "How **healthy** would you say {nodeLabel}'s diet is?"
            }
          },
          {
            "variable": "alter_drinks",
            "prompt": {
              "en": "How often does {nodeLabel} **drink alcohol**, as far as you know?"
            }
          }
        ]
      }
    },
    {
      "id": "ordbin-closeness",
      "type": "OrdinalBin",
      "label": { "en": "How close you are" },
      "subject": { "entity": "node", "type": "person" },
      "prompts": [
        {
          "id": "p-closeness",
          "text": {
            "en": "Place each person by **how close you feel to them**. Closer ties tend to have a stronger influence on our behaviour."
          },
          "variable": "closeness",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "narrative-clustering",
      "groupsHeading": { "en": "Groups" },
      "type": "Narrative",
      "label": { "en": "Review behavioural clustering" },
      "subject": { "entity": "node", "type": "person" },
      "behaviours": {
        "automaticLayout": true,
        "allowRepositioning": true,
        "freeDraw": true
      },
      "presets": [
        {
          "id": "preset-smoking",
          "label": { "en": "Smoking" },
          "layoutVariable": "layout",
          "groupVariable": "alter_smokes",
          "highlight": []
        },
        {
          "id": "preset-activity",
          "label": { "en": "Physical activity" },
          "layoutVariable": "layout",
          "groupVariable": "alter_activity",
          "highlight": []
        },
        {
          "id": "preset-drinking",
          "label": { "en": "Drinking" },
          "layoutVariable": "layout",
          "groupVariable": "alter_drinks",
          "highlight": []
        }
      ],
      "background": { "concentricCircles": 3, "skewedTowardCenter": true }
    },
    {
      "id": "finish",
      "finishLabel": { "en": "Finish" },
      "finishConfirmation": {
        "en": "Are you sure you want to finish the interview?"
      },
      "finishFailed": {
        "en": "The interview could not be finished. Please try again. If the problem continues, contact the study organizer."
      },
      "type": "FinishSession",
      "mode": "confirmation",
      "label": { "en": "Finish Interview" },
      "content": {
        "en": "# Finish Interview\n\nYou have reached the end of the interview. If you are satisfied with the information you have entered, you may finish the interview now."
      },
      "finishedContent": {
        "en": "# Interview Finished\n\nThank you for participating!"
      },
      "outcome": "completed"
    }
  ],
  "interfaceText": {
    "navigation": {
      "exitInterview": { "en": "Exit interview" },
      "exitInterviewDescription": {
        "en": "Your answers so far will be saved and you can continue later."
      },
      "back": { "en": "Back" },
      "continue": { "en": "Continue" },
      "exitFailed": {
        "en": "Your answers could not be saved, so the interview has not been closed. Please try again. If the problem continues, contact the study organizer."
      }
    },
    "interviewer": {
      "exitReview": { "en": "Exit review" },
      "exitReviewTitle": { "en": "Exit this review?" },
      "exitReviewDescription": {
        "en": "Changes made during this review will not be saved."
      },
      "hiddenScreen": { "en": "Hidden by answers" },
      "outsidePath": { "en": "Outside current path" },
      "showScreenTitle": { "en": "Show this screen?" },
      "hiddenScreenDescription": {
        "en": "This screen is hidden based on the answers given so far. Do you want to show it anyway?"
      },
      "outsidePathDescription": {
        "en": "This screen is outside the current interview path based on the answers given so far. Do you want to show it anyway?"
      },
      "showScreen": { "en": "Show screen" }
    },
    "buttons": {
      "cancel": { "en": "Cancel" },
      "done": { "en": "Done" },
      "yes": { "en": "Yes" },
      "pauseLayout": { "en": "Pause automatic layout" },
      "resumeLayout": { "en": "Resume automatic layout" },
      "copy": { "en": "Copy" },
      "copied": { "en": "Copied" }
    },
    "messages": {
      "stageError": {
        "en": "# There was an error\n\nThere was an error with the interview software, and this task could not be displayed.\n\nSome tasks, such as maps, need an internet connection, so check your connection and then try refreshing the page.\n\nIf the problem persists, please contact the study organizer and send them the debug information, which you can copy with the button below. You may be able to continue your interview by clicking the next button."
      },
      "error": { "en": "An error occurred." },
      "unnamed": { "en": "Unnamed" }
    },
    "search": {
      "searchLabel": { "en": "Search" },
      "searchNoMatch": { "en": "Nothing matched your search term." }
    },
    "forms": {
      "discardChangesTitle": { "en": "Discard changes?" },
      "discardChangesDescription": {
        "en": "Do you want to discard your changes?"
      }
    },
    "validation": {
      "required": {
        "en": "You must answer this question before continuing."
      },
      "minValue": { "en": "Enter a value greater than or equal to {min}." },
      "maxValue": { "en": "Enter a value less than or equal to {max}." },
      "minSelected": {
        "en": "{count, plural, one {Select at least # value.} other {Select at least # values.}}"
      },
      "unique": { "en": "Must be unique." }
    },
    "narrative": {
      "toggleDrawing": { "en": "Toggle drawing" },
      "toggleFreezing": { "en": "Toggle freezing annotations" },
      "resetAnnotations": { "en": "Reset annotations" }
    }
  }
}
