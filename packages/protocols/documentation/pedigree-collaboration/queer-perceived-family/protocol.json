{
  "name": "Who feels like family? (queer youth discussion prototype)",
  "description": "Participant-defined family, belonging, support and narrative reflection. Hypothetical prototype for collaborator review, not a validated instrument.",
  "schemaVersion": 9,
  "localization": { "defaultLocale": "en-US", "locales": ["en-US"] },
  "lastModified": "2026-10-05T00:00:00.000Z",
  "codebook": {
    "node": {
      "person": {
        "name": "Person",
        "label": { "en-US": "Person" },
        "color": "node-color-seq-1",
        "shape": {
          "default": "circle"
        },
        "variables": {
          "name": {
            "name": "name",
            "label": "name",
            "type": "text",
            "component": "Text",
            "validation": {
              "required": true,
              "unique": true
            }
          },
          "relationship_words": {
            "name": "relationship_words",
            "label": "relationship_words",
