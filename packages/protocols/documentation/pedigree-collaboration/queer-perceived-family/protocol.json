              },
              {
                "label": { "en-US": "Chosen family" },
                "value": "chosen"
              },
              {
                "label": { "en-US": "Partner or partner's family" },
                "value": "partner"
              },
              {
                "label": { "en-US": "Another kind of family" },
                "value": "another"
              }
            ]
          },
          "category_words": {
            "name": "category_words",
            "label": "category_words",
            "type": "text",
            "component": "Text"
          },
          "feels_family": {
            "name": "feels_family",
            "label": "feels_family",
            "type": "boolean",
