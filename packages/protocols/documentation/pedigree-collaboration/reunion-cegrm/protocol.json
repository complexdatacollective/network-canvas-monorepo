          "otherOptionLabel": {
            "en-US": "Something else"
          }
        }
      ],
      "filter": {
        "join": "AND",
        "rules": [
          {
            "id": "c0a8f2d1-4b6e-4a9c-8f3d-2e7b1a5c9d40",
            "type": "node",
            "options": {
              "type": "person",
              "attribute": "is_ego",
              "operator": "NOT",
              "value": true
            }
