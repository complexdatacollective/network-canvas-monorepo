  "stages": [
    {
      "id": "welcome",
      "type": "Information",
      "label": {
        "en": "Welcome"
      },
      "content": {
        "en": "# My world\n\nWe are going to make a picture of **your world**: the people, places, animals and things that matter to you.\n\nThere are no right or wrong answers. You can skip anything you do not want to talk about."
      }
    },
    {
      "id": "name-illustrated",
      "type": "NameGenerator",
      "label": {
        "en": "Who and what is in your world?"
      },
      "subject": {
        "entity": "node",
        "type": "world_illustrated"
      },
      "form": {
        "title": {
          "en": "Add to my world"
        },
        "fields": [
          {
            "id": "field-world_illustrated_name",
            "variable": "world_illustrated_name",
            "prompt": {
              "en": "What do you call them or it?"
            }
          },
          {
            "id": "field-world_illustrated_type",
            "variable": "world_illustrated_type",
            "prompt": {
              "en": "What kind of thing is it?"
            }
          }
        ]
      },
      "prompts": [
        {
          "id": "name-illustrated-prompt",
          "text": {
            "en": "Who and what is **important to you**? Add each one, and choose what kind of thing it is."
          }
        }
      ]
    },
    {
      "id": "map-illustrated",
      "type": "Sociogram",
      "label": {
        "en": "Make your map"
      },
      "subject": {
        "entity": "node",
        "type": "world_illustrated"
      },
      "background": {
        "concentricCircles": 3,
        "skewedTowardCenter": true
      },
      "prompts": [
        {
          "id": "map-illustrated-prompt",
          "text": {
            "en": "Put the things that matter **most** to you in the middle. Then tap two things to join them up if they **go together**."
          },
          "layout": {
            "layoutVariable": "world_illustrated_layout"
          },
          "edges": {
            "create": "goes_with",
            "display": ["goes_with"]
          }
        }
      ]
    },
    {
      "id": "accented-introduction",
      "type": "Information",
      "label": {
        "en": "Node-coloured shapes"
      },
      "content": {
        "en": "# The same shapes in the node colour\n\n_For researchers._ The next two screens repeat the task with a second node type. The main parts of its shapes are drawn in the node type's own colour (`var(--node-color)` and `var(--node-color-dark)`), and the details keep colours of their own. Change the node type's colour in Architect and every shape follows."
      }
    },
    {
      "id": "name-accented",
      "type": "NameGenerator",
      "label": {
        "en": "Add some more"
      },
      "subject": {
        "entity": "node",
        "type": "world_accented"
      },
      "form": {
        "title": {
          "en": "Add to my world"
        },
        "fields": [
          {
            "id": "field-world_accented_name",
            "variable": "world_accented_name",
            "prompt": {
              "en": "What do you call them or it?"
            }
          },
          {
            "id": "field-world_accented_type",
            "variable": "world_accented_type",
            "prompt": {
              "en": "What kind of thing is it?"
            }
          }
        ]
      },
      "prompts": [
        {
          "id": "name-accented-prompt",
          "text": {
            "en": "Add a few more things from your world, and choose what kind of thing each one is."
          }
        }
      ]
    },
    {
      "id": "map-accented",
      "type": "Sociogram",
      "label": {
        "en": "Make another map"
      },
      "subject": {
        "entity": "node",
        "type": "world_accented"
      },
      "background": {
        "concentricCircles": 3,
        "skewedTowardCenter": true
      },
      "prompts": [
        {
          "id": "map-accented-prompt",
          "text": {
            "en": "Put the things that matter **most** to you in the middle. Then tap two things to join them up if they **go together**."
          },
          "layout": {
            "layoutVariable": "world_accented_layout"
          },
          "edges": {
            "create": "goes_with_accented",
            "display": ["goes_with_accented"]
          }
        }
      ]
    },
    {
      "id": "finish",
      "finishLabel": {
        "en": "Finish"
      },
      "finishConfirmation": {
        "en": "Are you sure you want to finish the interview?"
      },
      "finishFailed": {
        "en": "The interview could not be finished. Please try again. If the problem continues, contact the study organizer."
      },
      "type": "FinishSession",
      "mode": "confirmation",
      "label": {
        "en": "Finish Interview"
      },
      "content": {
        "en": "# Finish Interview\n\nYou have reached the end of the interview. If you are satisfied with the information you have entered, you may finish the interview now."
      },
      "finishedContent": {
        "en": "# Interview Finished\n\nThank you for participating!"
      },
      "outcome": "completed"
    }
