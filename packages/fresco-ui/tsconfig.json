{
  "extends": "@codaco/tsconfig/web.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "outDir": "dist"
  },
  // The catalogs manifest imports src/locales/*.json, and a directory glob
  // does not add .json to a composite project's root files — the import then
  // fails with TS6307 even though the file resolves.
  "include": ["src", "src/**/*.json"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.stories.tsx",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "**/__tests__/**"
  ]
}
