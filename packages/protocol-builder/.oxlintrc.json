{
  "extends": [
    "../../.oxlintrc.json",
    "../../tooling/oxlint/react.json",
    "../../tooling/oxlint/direction.json"
  ],
  "jsPlugins": ["eslint-plugin-formatjs", "oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "tooling/tailwind/fresco/fresco.css",
      "variablePatterns": [
        "[a-z](?:Class|ClassNames?|Classes)$",
        "_CLASS(?:ES|_NAMES?)?$"
      ],
      "attributePatterns": ["^[a-z][A-Za-z]*ClassName$"]
    }
  },
  "rules": {
    // Right-to-left languages. The same rule, with the same exception, as
    // `@codaco/fresco-ui`'s configuration, which says why. It is the only
    // Tailwind rule on here: the rest of that plugin's set has never run
    // over this package.
    "tailwindcss/enforce-logical": [
      "error",
      { "direction": "inline", "allowlist": ["(^|:)left-1/2$"] }
    ],

    // Descriptor hygiene for the messages this package owns. These five are
    // the root config's set, repeated here because an override in the root
    // cannot match into a package that declares its own config — the root's
    // list names the packages that have none.
    "formatjs/enforce-description": "error",
    "formatjs/enforce-default-message": "error",
    "formatjs/no-invalid-icu": "error",
    "formatjs/enforce-placeholders": "error",
    "formatjs/no-multiple-whitespaces": "error"
  }
}
