# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.pnpm-store/


# next.js
**/.next/
**/out/

# production
**/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Everything apps/studio/stack-test generates for a run: the environment it
# interpolates the compose files from, the first-run setup token migrate
# printed, the nginx configuration and certificate the own-proxy variant
# builds, and the logs down.sh keeps.
apps/studio/stack-test/.work/

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
**/.vercel

# netlify
**/.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo

dist
dist-electron
release-builds

# protocol validation test protocols
/packages/protocol-validation/src/__tests__/data
**/src/__tests__/.cache

apps/documentation/public/sidebar.json

# Superpowers brainstorm sessions
.superpowers/

# Claude Code local state (worktrees, projects, settings)
# Ignore everything under .claude/ except shared, version-controlled skills
# and workflows.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/workflows/

# Playwright e2e artifacts
**/test-results/
**/playwright-report/
**/.playwright-mcp/
packages/interview/e2e/.assets/

# Storybook build output
storybook-static/

# pnpm pack output
**/codaco-interview-*.tgz

# Journey-agent scratch scripts must never enter version control
.scratch/

# Shallow reference clones the effect-v3-to-v4 skill makes (.repos/effect,
# .repos/effect-v3): read-only upstream checkouts, never part of the revision.
.repos/
