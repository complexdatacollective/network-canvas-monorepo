# Security headers applied to every response.
#
# The bulk of the Content-Security-Policy (default-src, script-src, connect-src,
# etc.) is injected into the HTML as a <meta http-equiv> at build time — see
# CONTENT_SECURITY_POLICY / injectCspMeta in vite.config.ts. It lives in the
# content, not here, so that a change to it rides the service worker's precache
# revision and reaches already-installed clients; a header-only CSP would be
# frozen in the precached HTML response and never update. Only `frame-ancestors`
# is set here, because a <meta> CSP cannot express it — and it, plus the
# X-Frame-Options / Referrer-Policy / X-Content-Type-Options response headers
# below, are stable and don't need to propagate the way connect-src does.
/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate

# Stable PWA entry points must not be stored by the browser or an intermediary.
# The /* rule also covers SPA deep-link requests that Netlify rewrites to
# index.html. Netlify's more-specific /assets/* rule below replaces only its
# Cache-Control value, so content-hashed assets remain immutable.
/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/preview/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/preview/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
# PWA icons are not content-hashed, so never store a renamed-in-place icon.
/favicon.ico
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/apple-touch-icon-180x180.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/pwa-64x64.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/pwa-192x192.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/pwa-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/maskable-icon-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/architect-icon.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Architect 8, served at /v8/ from this deploy (dist/v8; see
# scripts/legacy-architect.ts), with its own service worker. Its tarball's own
# _headers is dropped because Netlify reads only this one, so its contract is
# repeated here: stable entry points and icons never stored, hashed assets
# immutable (every stable path above, rebased under /v8/).
/v8/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/sw.js
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/manifest.webmanifest
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/preview/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/preview/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/favicon.ico
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/apple-touch-icon-180x180.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/pwa-64x64.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/pwa-192x192.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/pwa-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/maskable-icon-512x512.png
