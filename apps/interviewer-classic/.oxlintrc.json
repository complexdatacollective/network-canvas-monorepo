{
  "extends": [
    "../../.oxlintrc.json",
    "../../tooling/oxlint/react.json",
    "../../tooling/oxlint/classic.json"
  ],
  "jsPlugins": ["../../tooling/oxlint/tailwindcss.mjs"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "tooling/tailwind/fresco/fresco.css"
    }
  },
  "rules": {
    "tailwindcss/no-unknown-classes": "off",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "off",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/enforce-canonical": "off"
  }
}
