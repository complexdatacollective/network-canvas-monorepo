# Environment for the Network Canvas Studio compose stack (#1909).
#
# Copy this file to `.env` beside `docker-compose.yml` and fill it in. It is
# the second of the two files a self-hoster downloads, and every variable
# `docker-compose.yml` reads is here.
#
# This is NOT the same file as `server/.env.example`, which is generated from
# the server's environment catalogue and describes the variables one Studio
# process reads. This one describes the stack: hostnames, image references,
# the network, and the credentials the stack's own containers share. The
# compose file turns these into the server's variables.
#
# The database password and the secrets keyring are NOT here. They are file
# secrets under `secrets/` — see `secrets/README.md`.

# -------------------
# The instance
# -------------------

# The hostname this instance is served on. One hostname serves the app, the
# API, the WebSocket and asset storage, so the browser stays same-origin. It
# must already resolve to this host: Traefik proves control of it over HTTP to
# get a certificate.
STUDIO_HOSTNAME=studio.example.org

# Where Let's Encrypt sends expiry warnings for that certificate.
ACME_EMAIL=admin@example.org

# -------------------
# Images
# -------------------

# Placeholders. Pin these to a digest (`…@sha256:…`) on a real instance, the
# way every other image in the compose file is pinned: a tag can be moved, and
# an instance that pulls a moved tag has upgraded without being told to. The
# published images and their digests arrive with the publishing lane (#1910);
# until then they are built from a checkout of this repository:
#
#   docker build -f apps/studio/Dockerfile --target studio-api -t studio-api .
#   docker build -f apps/studio/Dockerfile --target studio-web -t studio-web .
STUDIO_API_IMAGE=ghcr.io/complexdatacollective/studio-api:latest
STUDIO_WEB_IMAGE=ghcr.io/complexdatacollective/studio-web:latest

# -------------------
# Network
# -------------------

# The subnet the stack's own network is given. It is also what the API trusts
# `X-Forwarded-For` from, so it must name the network Traefik is on and
# nothing else. Change it only if it collides with something already on this
# host.
STACK_SUBNET=172.31.240.0/24

# -------------------
# Database
# -------------------

# The login the server connects as. It owns the schema, and needs CREATEROLE
# the first time the schema is applied — which the stack's own Postgres
# superuser has. Its password is the `secrets/postgres-password` file secret,
# never a value here.
POSTGRES_USER=studio
POSTGRES_DB=studio

# Swapping in a managed Postgres is this one line: unset, the compose file
# builds `postgres://<POSTGRES_USER>@postgres:5432/<POSTGRES_DB>` from the two
# above. The password is NOT part of it either way — `DATABASE_PASSWORD_FILE`
# still names `secrets/postgres-password`, so put the managed instance's
# password in that file, and leave the URL without one (a URL carrying a
# password as well is refused at boot). Then delete the `postgres` service and
# the `postgres-data` volume.
#DATABASE_URL=postgres://studio@postgres.example.org:5432/studio

# -------------------
# Authentication
# -------------------

# Signs sessions and magic-link tokens. Generate one:
#
#   openssl rand -base64 32
#
# Changing it signs every open session out.
BETTER_AUTH_SECRET=

# -------------------
# Object storage
# -------------------

# The stack's own Garage. S3_REGION must be the region the store expects
# requests to be signed for; Garage is configured with whatever is set here,
# so leaving it alone works, and a managed bucket has its own.
S3_REGION=garage
S3_BUCKET=studio

# Swapping in a managed bucket (R2, S3) is this line plus the four variables
# around it: unset, the compose file points at the stack's own Garage. Once it
# names a provider, delete the `garage` and `garage-init` services, the entry
# for `garage-init` in `migrate`'s `depends_on`, the `garage-config` and
# `garage-init` configs, and the `garage-data` volume — and ignore the two
# GARAGE_* values below, which only that container reads.
#S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Garage's own key format: `GK` followed by 24 hex characters, and 64 hex
# characters of secret. Generate a pair:
#
#   echo "GK$(openssl rand -hex 12)"
#   openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Garage's internal secrets. The RPC secret is shared between nodes of a
# cluster — required even with one node — and the admin token is what the
# bootstrap one-shot authenticates with. Generate each:
#
#   openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# -------------------
# Rate limiting
# -------------------

# Counters for the shared rate limiter, and nothing else — they are ephemeral
# by design, so this store needs no persistence and no backup. Unset, the
# compose file points at the stack's own Valkey. Any Redis 7-compatible server
# works; once this names one, delete the `valkey` service and the `depends_on`
# entries naming it.
#REDIS_URL=redis://redis.example.org:6379

# -------------------
# Mail
# -------------------

# Sign-in links and team invitations are sent through this transport, by the
# worker. Set both or neither: EMAIL_FROM without SMTP_URL is refused at boot.
# With neither, mail queues until one is configured and nobody can sign in by
# magic link.
#
#   SMTP_URL=smtp://user:password@smtp.example.org:587
#   EMAIL_FROM=studio@studio.example.org
SMTP_URL=
EMAIL_FROM=

# -------------------
# Optional: OAuth sign-in
# -------------------

# Each pair is all-or-nothing, and unset means the provider is simply not
# offered on the sign-in screen. The redirect URI to register is
# `https://<STUDIO_HOSTNAME>/api/auth/callback/<provider>`.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
# Only for a single-tenant Entra registration; unset accepts any account.
#MICROSOFT_TENANT_ID=
