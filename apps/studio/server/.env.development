# Local development defaults for the Studio server.
# Generated by `pnpm --filter @codaco/studio-server generate:env-docs` — do not edit by hand.
# The source is apps/studio/server/src/env/catalogue.ts.
#
# Committed on purpose: a fresh clone runs `pnpm --filter
# @codaco/studio-server dev` with no setup. These credentials are
# intentional test values pointing at the Docker containers the dev
# script provisions, and are safe to publish.
#
# No deployment path loads this file. To override a value locally, put it
# in a gitignored `.env` beside this file — the dev script loads that
# second, so it wins.

# Process
# Marks the process as running against the committed development defaults.
STUDIO_DEV_DEFAULTS=1

# Object storage
# S3-compatible endpoint holding content-addressed asset bytes.
S3_ENDPOINT=http://localhost:9100
# Region passed to the S3 client.
S3_REGION=us-east-1
# Bucket asset objects are written to and read from.
S3_BUCKET=studio-dev
# Access key for the object store.
S3_ACCESS_KEY_ID=minioadmin
# Secret key for the object store.
S3_SECRET_ACCESS_KEY=minioadmin

# Database
# Postgres connection string, pg.Pool's native format.
DATABASE_URL=postgres://postgres:spike@127.0.0.1:54318/studio_dev

# Authentication
# Signing secret for sessions and magic-link tokens.
BETTER_AUTH_SECRET=studio-dev-secret-not-for-production
# The browser-facing origin. Cookies and magic-link URLs are minted against
# it.
PUBLIC_URL=http://localhost:5173
# From address on magic-link email.
EMAIL_FROM=studio-dev@localhost
