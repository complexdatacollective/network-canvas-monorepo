# Environment template for a Studio deployment.
# Generated by `pnpm --filter @codaco/studio-server generate:env-docs` — do not edit by hand.
# The source is apps/studio/server/src/env/catalogue.ts.
#
# Copy to `.env` and fill in. Every variable is optional at boot: an
# unconfigured surface refuses at request time rather than preventing the
# server from starting.

# -------------------
# Process
# -------------------
# Runtime mode. Anything other than production leaves development
# affordances available.
# Set to production by the studio-api image.
#NODE_ENV=production
# TCP port the HTTP server listens on.
# Unset => 3000.
#PORT=3000
# Interface the HTTP server binds to.
# Unset => 0.0.0.0.
#HOST=0.0.0.0
# TCP port the worker process serves /healthz and /readyz on, bound to
# 127.0.0.1 only.
# Unset => 3001. The worker routes no traffic, so this listener exists for
# the container healthcheck and is never published or proxied; the address
# it binds is fixed in code, not configurable. The web process ignores it
# and serves the same two routes on PORT.
#WORKER_HEALTH_PORT=3001
# Whether this instance reports anonymous usage telemetry. Declared here so
# the development lane can turn it off; nothing reads it until #1897 builds
# the reporting it governs.
# Unset => true. Set to false to opt an instance out. It does not govern the
# update check (#1901), which is not configurable and is blocked at the
# firewall instead.
#STUDIO_TELEMETRY=true
# Which topology this deployment serves: managed (marketing, pricing,
# sign-up, billing) or self-hosted (first-run setup). The other topology's
# paths are refused with 404.
# Unset => self-hosted. The managed deployment sets managed in the container
# environment, at run time rather than at build time, because every
# entrypoint reads it inside the running process.
#STUDIO_DEPLOYMENT_MODE=self-hosted

# -------------------
# Object storage
# -------------------
# S3-compatible endpoint holding content-addressed asset bytes.
# Required with the other four S3_* variables.
#S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# Region passed to the S3 client.
# Required with the other four S3_* variables.
#S3_REGION=us-east-1
# Bucket asset objects are written to and read from.
# Required with the other four S3_* variables.
#S3_BUCKET=studio-assets
# Access key for the object store.
# Required with the other four S3_* variables.
#S3_ACCESS_KEY_ID=
# Secret key for the object store.
# Required with the other four S3_* variables.
#S3_SECRET_ACCESS_KEY=

# -------------------
# Database
# -------------------
# Postgres connection string, pg.Pool's native format.
# Unset => no database; auth and sync refuse while the server still boots.
# The login owns the schema and needs CREATEROLE the first time apply-schema
# runs; the server runs as the studio_app role it creates. A connection
# string carrying an options parameter is refused at boot: node-postgres
# would let it override the role= every pool pins itself with, and both
# processes would run as the login instead.
#DATABASE_URL=postgres://user@host:5432/studio
# Path of a file holding the password for DATABASE_URL, which must then
# carry none.
# How the reference compose stack delivers the database password: a Compose
# file secret at /run/secrets/postgres_password, so it appears neither in
# docker inspect nor in any process environment. The file is read once at
# boot and its password inserted into DATABASE_URL. Setting it while
# DATABASE_URL also carries a password is a boot error — there would be no
# way to tell which was meant. Trailing newlines are stripped, matching what
# the Postgres image does with the same file.
#DATABASE_PASSWORD_FILE=/run/secrets/postgres_password

# -------------------
# Secrets
# -------------------
# The keyring Studio encrypts stored secrets with — webhook signing secrets,
# API-key protocol assets and OAuth tokens. One or more <id>:<base64 of 32
# bytes> entries separated by commas or whitespace, the first of which is
# the one new values are written under.
# Required whenever DATABASE_URL is set, unless STUDIO_SECRETS_KEY_FILE
# names a file holding it; setting both is refused at boot. Generate an
# entry with openssl rand -base64 32 and write it as k1:<value>. Back it up
# with the database: without it every stored secret is unreadable, and the
# server refuses to start rather than serve a database it can only half
# read. Rotate by adding a new entry at the front, deploying, running
# studio-api rotate-secrets, and then removing the old entry.
#STUDIO_SECRETS_KEY=k1:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
# Path to a file holding the keyring, read once at boot; the file may put
# one entry per line.
# The reference stack mounts the keyring as a Compose file secret under
# /run/secrets, so it never appears in docker inspect or in a log of the
# environment. Takes the place of STUDIO_SECRETS_KEY, which stays for
# development and for hosts that have no file secrets; setting both is
# refused at boot.
#STUDIO_SECRETS_KEY_FILE=/run/secrets/studio_secrets_key

# -------------------
# Authentication
# -------------------
# Signing secret for sessions and magic-link tokens.
# Required whenever DATABASE_URL is set. Generate one with openssl rand
# -base64 32.
#BETTER_AUTH_SECRET=
# The browser-facing origin. Cookies, magic-link URLs, and team-invitation
# URLs are minted against it.
# Required whenever DATABASE_URL is set.
#PUBLIC_URL=https://studio.example.org
# SMTP transport sign-in and team-invitation email is sent through.
# Read by the worker process, which sends every message Studio sends; the
# web process never reads it. Unset => the worker boots without its mail
# workers and says so, and sign-in and invitation mail queues until one is
# configured. A sign-in or invitation link is never written to the log
# outside development.
#SMTP_URL=smtp://user:password@smtp.example.org:587
# From address on sign-in and team-invitation email.
# Read by the worker process alongside SMTP_URL: required with it, and
# refused without it.
#EMAIL_FROM=studio@studio.example.org
# OAuth client ID for "Continue with Google" sign-in (#1255).
# Required with GOOGLE_CLIENT_SECRET; unset => Google sign-in is not
# offered. Create a Web application OAuth client in the Google Cloud Console
# with <PUBLIC_URL>/api/auth/callback/google as an authorized redirect URI.
#GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OAuth client secret paired with GOOGLE_CLIENT_ID.
# Required with GOOGLE_CLIENT_ID, and refused without it.
#GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Entra application (client) ID for "Continue with Microsoft" sign-in
# (#1255).
# Required with MICROSOFT_CLIENT_SECRET; unset => Microsoft sign-in is not
# offered. Register an application in Microsoft Entra with
# <PUBLIC_URL>/api/auth/callback/microsoft as a Web redirect URI.
#MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret paired with MICROSOFT_CLIENT_ID.
# Required with MICROSOFT_CLIENT_ID, and refused without it.
#MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Entra tenant to accept sign-ins from, for single-tenant registrations.
# Unset => common (any organizational or personal Microsoft account,
# matching a multitenant registration). Refused without the other two
# MICROSOFT_* variables.
#MICROSOFT_TENANT_ID=contoso.onmicrosoft.com
# Password of the admin@studio.test account the seed command creates, which
# owns every seeded team.
# Read only by seed and db:reset. Required to seed a non-local database: the
# published development password is refused there, because it is a working
# credential on any instance that keeps it. Unset => the development
# password, for local databases only.
#STUDIO_SEED_ADMIN_PASSWORD=a-long-random-value-chosen-for-this-instance
# Comma-separated proxy addresses or CIDRs whose X-Forwarded-For may be
# trusted when resolving the client IP.
# Unset => forwarded headers are not read at all, which is safe but shares
# one rate-limit bucket across every client. List only your own proxies, and
# only where each one overwrites the header rather than appending to a
# client-supplied value.
#TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# -------------------
# Rate limiting
# -------------------
# Redis 7-compatible server (the reference stack runs Valkey) holding every
# rate-limit counter.
# Unset => there is no limiter store, every limit below is disabled, and the
# server says so once at boot outside development. The reference compose
# stack always sets it. Any Redis 7-compatible server will do — the limiter
# uses EVAL, sorted sets and hashes and nothing else — and the counters are
# disposable: losing them resets every window rather than losing data.
#REDIS_URL=redis://valkey:6379
# Sign-in and magic-link requests per client address, as count/window.
# Unset => 10/10m. Ten attempts from one address in ten minutes covers a
# shared institutional address whose users mistype passwords, and makes
# credential stuffing from a single host pointless.
#RATE_LIMIT_SIGN_IN_ADDRESS=10/10m
# Sign-in and magic-link requests per email address.
# Unset => 5/10m. An account belongs to one person, and a person who has
# failed five times in ten minutes needs the reset link rather than a sixth
# attempt. This is the limit an attacker spreading attempts across addresses
# meets.
#RATE_LIMIT_SIGN_IN_EMAIL=5/10m
# Team-invitation acceptances per invitation token.
# Unset => 10/10m. An invitation is accepted once; ten allows a reload, a
# wrong account, and a sign-in in between, and stops a token being
# brute-forced through one link.
#RATE_LIMIT_INVITATION_ACCEPT=10/10m
# Participation-link redemptions per client address.
# Unset => 20/10m. A lab runs several interviews from one address, so this
# is deliberately loose; the per-link limit below is what protects a single
# link. Declared now and enforced when the participant routes land (#1899).
#RATE_LIMIT_PARTICIPANT_REDEEM_ADDRESS=20/10m
# Participation-link redemptions per link.
# Unset => 5/10m. A link is redeemed once, so five covers a reload and a
# lost response while making a link identifier not worth guessing. Declared
# now and enforced when the participant routes land (#1899).
#RATE_LIMIT_PARTICIPANT_REDEEM_LINK=5/10m
# Interview sync writes per participant session.
# Unset => 600/1m. Ten writes a second is far above what answering questions
# produces and far below what a script replaying a session could. Declared
# now and enforced when the participant routes land (#1899).
#RATE_LIMIT_PARTICIPANT_SYNC=600/1m
# Internal RPC calls per signed-in user.
# Unset => 600/1m. The app issues a burst of calls per screen, so the limit
# is a ceiling on a runaway client rather than a budget a person can feel:
# ten calls a second sustained is more than any screen needs.
#RATE_LIMIT_RPC_USER=600/1m
# Internal RPC calls per team, across everyone in it.
# Unset => 3000/1m. A team is many researchers working at once, so this
# protects the instance rather than the person: it is five times the
# per-user limit, which one runaway client cannot reach alone.
#RATE_LIMIT_RPC_TEAM=3000/1m
# Reads from /storage, per participant session where the request carries one
# and otherwise per client address.
# Unset => 2000/5m. Generous by design: an interview fetches every stimulus
# it shows, and an institution often puts a whole building behind one
# address. Keyed per client address until the participant session token
# exists (#1899).
#RATE_LIMIT_STORAGE_READ=2000/5m
# Calls to /api/v1, per API token where the request carries one and
# otherwise per client address.
# Unset => 300/1m. Five calls a second suits an analysis script paging
# through results and leaves the instance responsive to everyone else.
#RATE_LIMIT_PUBLIC_API=300/1m
# WebSocket upgrades per signed-in user.
# Unset => 30/1m. A tab opens one socket and reopens it when the network
# drops, so thirty a minute absorbs a flapping connection while stopping a
# reconnect loop from becoming a connection storm.
#RATE_LIMIT_WS_UPGRADE=30/1m
