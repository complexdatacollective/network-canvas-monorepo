# Environment template for a Studio deployment.
# Generated by `pnpm --filter @codaco/studio-server generate:env-docs` — do not edit by hand.
# The source is apps/studio/server/src/env/catalogue.ts.
#
# Copy to `.env` and fill in. Every variable is optional at boot: an
# unconfigured surface refuses at request time rather than preventing the
# server from starting.

# -------------------
# Process
# -------------------
# Runtime mode. Anything other than production leaves development
# affordances available.
# Set to production by the Docker image and by Netlify.
#NODE_ENV=production
# TCP port the HTTP server listens on.
# Unset => 3000.
#PORT=3000
# Bearer token required to read the protected Prometheus /metrics endpoint.
# Unset => /metrics refuses with 404. Use a separate random secret of at
# least 32 characters (openssl rand -base64 32); configure it only on
# operator scrapers. Never use the authentication signing secret.
#STUDIO_METRICS_TOKEN=
# Interface the HTTP server binds to.
# Unset => 0.0.0.0.
#HOST=0.0.0.0
# Directory of built client assets to serve, resolved against the working
# directory.
# Unset => ../client relative to the server bundle, the Docker image layout.
# Irrelevant where a CDN serves the client.
#CLIENT_DIST=../client/dist
# Which topology this deployment serves: managed (marketing, pricing,
# sign-up, billing) or self-hosted (first-run setup). The other topology's
# paths are refused with 404.
# Unset => self-hosted. The managed deployment sets managed in its runtime
# environment — the container environment, or a Netlify site variable, never
# a build-time one, because both entrypoints read it inside the running
# process.
#STUDIO_DEPLOYMENT_MODE=self-hosted

# -------------------
# Object storage
# -------------------
# S3-compatible endpoint holding content-addressed asset bytes.
# Required with the other four S3_* variables.
#S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# Region passed to the S3 client.
# Required with the other four S3_* variables.
#S3_REGION=us-east-1
# Bucket asset objects are written to and read from.
# Required with the other four S3_* variables.
#S3_BUCKET=studio-assets
# Access key for the object store.
# Required with the other four S3_* variables.
#S3_ACCESS_KEY_ID=
# Secret key for the object store.
# Required with the other four S3_* variables.
#S3_SECRET_ACCESS_KEY=

# -------------------
# Database
# -------------------
# Postgres connection string, pg.Pool's native format.
# Unset => no database; auth and sync refuse while the server still boots.
# The login owns the schema and needs CREATEROLE the first time apply-schema
# runs; the server runs as the studio_app role it creates.
#DATABASE_URL=postgres://user:password@host:5432/studio

# -------------------
# Authentication
# -------------------
# Signing secret for sessions and magic-link tokens.
# Required whenever DATABASE_URL is set. Generate one with openssl rand
# -base64 32.
#BETTER_AUTH_SECRET=
# The browser-facing origin. Cookies, magic-link URLs, and team-invitation
# URLs are minted against it.
# Required whenever DATABASE_URL is set.
#PUBLIC_URL=https://studio.example.org
# SMTP transport sign-in and team-invitation email is sent through.
# Unset => magic-link sends refuse and team invitations cannot be created. A
# sign-in or invitation link is never written to the log outside
# development.
#SMTP_URL=smtp://user:password@smtp.example.org:587
# From address on sign-in and team-invitation email.
# Required alongside SMTP_URL, and refused without it.
#EMAIL_FROM=studio@studio.example.org
# OAuth client ID for "Continue with Google" sign-in (#1255).
# Required with GOOGLE_CLIENT_SECRET; unset => Google sign-in is not
# offered. Create a Web application OAuth client in the Google Cloud Console
# with <PUBLIC_URL>/api/auth/callback/google as an authorized redirect URI.
#GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OAuth client secret paired with GOOGLE_CLIENT_ID.
# Required with GOOGLE_CLIENT_ID, and refused without it.
#GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Entra application (client) ID for "Continue with Microsoft" sign-in
# (#1255).
# Required with MICROSOFT_CLIENT_SECRET; unset => Microsoft sign-in is not
# offered. Register an application in Microsoft Entra with
# <PUBLIC_URL>/api/auth/callback/microsoft as a Web redirect URI.
#MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret paired with MICROSOFT_CLIENT_ID.
# Required with MICROSOFT_CLIENT_ID, and refused without it.
#MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Entra tenant to accept sign-ins from, for single-tenant registrations.
# Unset => common (any organizational or personal Microsoft account,
# matching a multitenant registration). Refused without the other two
# MICROSOFT_* variables.
#MICROSOFT_TENANT_ID=contoso.onmicrosoft.com
# Password of the admin@studio.test account the seed command creates, which
# owns every seeded team.
# Read only by seed and db:reset. Required to seed a non-local database: the
# published development password is refused there, because it is a working
# credential on any instance that keeps it. Unset => the development
# password, for local databases only.
#STUDIO_SEED_ADMIN_PASSWORD=a-long-random-value-chosen-for-this-instance
# Comma-separated proxy IP addresses or CIDRs. A UUID X-Request-Id is
# accepted only when the actual transport peer is in this list.
# Unset => request ids are generated locally and forwarded headers are not
# read for authentication. List only your own proxies, each overwriting
# client-supplied request-id and forwarded headers. Header values never
# establish transport trust; fetch-only runtimes without socket information
# always generate request ids.
#TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
