{
  "name": "@codaco/studio-server",
  "version": "0.2.0",
  "private": true,
  "description": "Network Canvas Studio server — the Node deployable behind the studio-api image: public data API, internal RPC surface, app WebSocket endpoint, background worker, and the schema migrate command.",
  "author": "Complex Data Collective <hello@complexdatacollective.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/complexdatacollective/network-canvas-monorepo.git",
    "directory": "apps/studio/server"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts --prepare && concurrently -k -n stack,server,worker,client \"node scripts/dev.ts --follow\" \"node --env-file-if-exists=.env.development --env-file-if-exists=.env --watch --watch-path=src --watch-path=../../../packages/studio-rpc/src --watch-path=../../../packages/studio-sync/src --watch-path=../../../packages/shared-consts/src --watch-path=../../../packages/protocol-validation/src --watch-path=package.json src/index.ts\" \"node --env-file-if-exists=.env.development --env-file-if-exists=.env --watch --watch-path=src --watch-path=../../../packages/studio-rpc/src --watch-path=../../../packages/studio-sync/src --watch-path=../../../packages/shared-consts/src --watch-path=../../../packages/protocol-validation/src --watch-path=package.json src/worker.ts\" \"pnpm --filter @codaco/studio-client dev\"",
    "dev:down": "node scripts/dev.ts --down",
    "dev:stack": "node scripts/dev-stack.ts",
    "dev:stack:down": "node scripts/dev-stack.ts --down",
    "build": "vite build && node scripts/render-schema-ddl.ts",
    "apply-schema": "pnpm run sync-fingerprint && node --env-file-if-exists=.env scripts/apply-schema.ts",
    "rotate-secrets": "node --env-file-if-exists=.env src/rotate-secrets.ts",
    "sync-fingerprint": "node scripts/sync-fingerprint.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "pnpm run sync-fingerprint && node scripts/db-reset.ts",
    "protocol-demo": "node scripts/protocol-demo.ts",
    "generate:env-docs": "node scripts/generate-env-docs.ts",
    "generate:erd": "node scripts/generate-schema-docs.ts",
    "check:schema-docs": "node scripts/check-schema-docs.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "start:worker": "NODE_ENV=production node --env-file-if-exists=.env dist/worker.js",
    "start:migrate": "NODE_ENV=production node --env-file-if-exists=.env dist/migrate.js",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@codaco/protocol-builder-core": "workspace:^",
    "@codaco/protocol-utilities": "workspace:^",
    "@codaco/protocol-validation": "workspace:^",
    "@codaco/protocols": "workspace:^",
    "@codaco/shared-consts": "workspace:^",
    "@codaco/studio-rpc": "workspace:^",
    "@codaco/studio-sync": "workspace:^",
    "@faker-js/faker": "catalog:",
    "@hono/node-server": "^2.1.0",
    "@noble/hashes": "^2.3.0",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "^4.13.5",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.9",
    "pg": "^8.23.0",
    "pg-boss": "12.31.1",
    "pg-connection-string": "^2.14.0",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@codaco/tsconfig": "workspace:^",
    "@dbml/core": "10.1.1",
    "@effect/vitest": "catalog:",
    "@orpc/client": "catalog:",
    "@softwaretechnik/dbml-renderer": "1.0.31",
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
