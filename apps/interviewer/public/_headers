# Stable PWA entry points must not be stored by the browser or an intermediary.
# The /* rule also covers SPA deep-link requests that Netlify rewrites to
# index.html. Netlify's more-specific /assets/* rule below replaces its
# Cache-Control value, so content-hashed assets remain immutable.
/*
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
# PWA icons are not content-hashed, so never store a renamed-in-place icon.
/favicon.ico
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/apple-touch-icon-180x180.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/pwa-64x64.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/pwa-192x192.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/pwa-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/maskable-icon-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/interviewer-icon.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Interviewer 8, served at /v8/ from this deploy (dist/v8; see
# scripts/buildtime/legacy-app.ts), with its own service worker. Its
# tarball's own _headers is dropped because Netlify reads only this one, so its
# contract is repeated here: stable entry points and icons never stored, hashed
# assets immutable (every stable path above, rebased under /v8/).
/v8/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/sw.js
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/manifest.webmanifest
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/favicon.ico
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/apple-touch-icon-180x180.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/pwa-64x64.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/pwa-192x192.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/pwa-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/maskable-icon-512x512.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/interviewer-icon.png
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
/v8/assets/*
  Cache-Control: public, max-age=31536000, immutable
