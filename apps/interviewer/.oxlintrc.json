{
  "extends": ["../../.oxlintrc.json", "../../tooling/oxlint/react.json"],
  "jsPlugins": ["oxlint-tailwindcss", "eslint-plugin-formatjs"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "tooling/tailwind/fresco/fresco.css",
      "variablePatterns": [
        "[a-z](?:Class|ClassNames?|Classes)$",
        "_CLASS(?:ES|_NAMES?)?$"
      ],
      "attributePatterns": ["^[a-z][A-Za-z]*ClassName$"]
    }
  },
  "rules": {
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    // `focusable` sets its transition only under :focus-visible, a more
    // specific selector, so an element's own transition classes apply until
    // the ring shows. The rule reads that nested block as unconditional.
    "tailwindcss/no-conflicting-classes": [
      "error",
      {
        "allow": [
          [
            "(^|:)focusable(-within)?$",
            "(^|:)(transition|duration|ease|delay)(-|$)"
          ]
        ]
      }
    ],
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/enforce-canonical": "error",
    // Right-to-left languages. The same rule, with the same exception, as
    // `@codaco/fresco-ui`'s configuration, which says why.
    "tailwindcss/enforce-logical": [
      "error",
      { "direction": "inline", "allowlist": ["(^|:)left-1/2$"] }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "formatjs/enforce-description": "error",
        "formatjs/enforce-default-message": "error",
        "formatjs/no-invalid-icu": "error",
        "formatjs/enforce-placeholders": "error",
        "formatjs/no-multiple-whitespaces": "error",
        "formatjs/no-literal-string-in-jsx": [
          "error",
          {
            "props": {
              "include": [
                [
                  "*",
                  "{label,placeholder,title,description,hint,message,heading,header,caption,text,fallback,required,alt,noResults,showMore,announcedName,unsavedWorkCaveat,*Label,*Text,*Title,*Message,*Description,*Placeholder,*Heading,*Caption,*Hint}"
                ]
              ]
            }
          }
        ]
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/__tests__/**",
        "src/storybook/**"
      ],
      "rules": {
        "formatjs/no-literal-string-in-jsx": "off"
      }
    }
  ]
}
