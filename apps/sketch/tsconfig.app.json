{
  "extends": "@codaco/tsconfig/web.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.app.json",
    "types": ["vite/client", "@total-typescript/ts-reset"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/server/**"]
}
