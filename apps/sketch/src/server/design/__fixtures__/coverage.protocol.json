      ],
      "filter": {
        "rules": [
          {
            "id": "rule_3",
            "type": "node",
            "options": {
              "type": "classmate",
              "attribute": "classmate_studies_together",
              "operator": "EXACTLY",
              "value": true
            }
          }
        ]
