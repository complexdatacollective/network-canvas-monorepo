  "stages": [
    {
      "id": "researcher_notes",
      "type": "Information",
      "label": {
        "en": "Researcher notes (delete before fielding)"
      },
      "title": {
        "en": "Notes for the research team"
      },
      "items": [
        {
          "id": "text",
          "type": "text",
          "content": {
            "en": "**About this draft.** Sketch drafted this protocol from a study description. Review every stage before fielding.\n\n**Study.** Students, classmates and the places they study.\n\n**Design rationale.** Exercises every branch of the compiler.\n\n**Placeholder roster.** Stage \"Classmates\" picks classmates from a generated list of 12 example rows (classmates_roster.csv). Replace it in Architect with your real list before fielding, keeping the column headers: name, year_of_study, major, commuter.\n\n**Map token.** The map stage uses the Network Canvas testing Mapbox token, which only works on networkcanvas.com sites and localhost. Replace the \"Mapbox token\" resource with your own token before fielding."
          }
        }
      ]
    },
    {
      "id": "consent",
      "type": "EgoForm",
      "label": {
        "en": "Consent"
      },
      "introductionPanel": {
        "title": {
          "en": "Taking part"
        },
        "text": {
          "en": "Please read the information about this study before deciding whether to take part."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "ego_consent",
            "prompt": {
              "en": "Do you agree to take part in this study?"
            }
          }
        ]
      }
    },
    {
      "id": "about",
      "type": "EgoForm",
      "label": {
        "en": "About"
      },
      "introductionPanel": {
        "title": {
          "en": "About you"
        },
        "text": {
          "en": "Please answer the following questions about yourself."
        }
      },
      "form": {
        "fields": [
          {
            "variable": "ego_year",
            "prompt": {
              "en": "Which year of study are you in?"
            }
          },
          {
            "variable": "ego_commutes",
            "prompt": {
              "en": "Do you commute to campus?"
            }
          }
        ]
      },
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_1",
              "type": "ego",
              "options": {
                "attribute": "ego_consent",
                "operator": "EXACTLY",
                "value": false
              }
            }
          ]
        },
        "destination": {
          "type": "finish"
        }
      }
    },
    {
      "id": "classmates_intro",
      "type": "Information",
      "label": {
        "en": "Classmates (introduction)"
      },
      "title": {
        "en": "Naming classmates"
      },
      "items": [
        {
          "id": "text",
          "type": "text",
          "content": {
            "en": "On the next screen you will see a list of classmates. Find everyone the question describes, using the search if it helps, and drag each one into the panel of people you have added."
          }
        }
      ]
    },
    {
      "id": "classmates",
      "type": "NameGeneratorRoster",
      "label": {
        "en": "Classmates"
      },
      "subject": {
        "entity": "node",
        "type": "classmate"
      },
      "prompts": [
        {
          "id": "p1",
          "text": {
            "en": "Select the classmates you **study with**."
          },
          "additionalAttributes": [
            {
              "variable": "classmate_studies_together",
              "value": true
            }
          ]
        }
      ],
      "behaviours": {
        "minNodes": 1
      },
      "dataSource": "classmates_roster",
      "cardOptions": {
        "additionalProperties": [
          {
            "label": {
              "en": "year of study"
            },
            "variable": "classmate_year_of_study"
          },
          {
            "label": {
              "en": "major"
            },
            "variable": "classmate_major"
          },
          {
            "label": {
              "en": "commuter"
            },
            "variable": "classmate_commuter"
          }
        ]
      },
      "sortOptions": {
        "sortOrder": [
          {
            "property": "classmate_name",
            "direction": "asc"
          }
        ],
        "sortableProperties": [
          {
            "label": {
              "en": "Name"
            },
            "variable": "classmate_name"
          }
        ]
      },
      "searchOptions": {
        "fuzziness": 0.5,
        "matchProperties": ["classmate_name"]
      },
      "panelTitle": {
        "en": "Available to add"
      },
      "minNodesNotice": {
        "en": "{count, plural, one {You must create at least # item before you can continue.} other {You must create at least # items before you can continue.}}"
      },
      "allAddedNotice": {
        "en": "There is nothing left to add from this list."
      }
    },
    {
      "id": "places_intro",
      "type": "Information",
      "label": {
        "en": "Places (introduction)"
      },
      "title": {
        "en": "Naming places"
      },
      "items": [
        {
          "id": "text",
          "type": "text",
          "content": {
            "en": "On the next screen you will be asked a question. For each place who comes to mind, tap the add button, answer a few short questions about them, and save. Move on when you have added everyone."
          }
        }
      ]
    },
    {
      "id": "places",
