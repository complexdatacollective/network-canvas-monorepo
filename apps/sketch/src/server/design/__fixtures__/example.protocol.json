  "stages": [
    {
      "id": "researcher_notes",
      "type": "Information",
      "label": "Researcher notes (delete before fielding)",
      "title": "Notes for the research team",
      "items": [
        {
          "id": "text",
          "type": "text",
          "content": "**About this draft.** Sketch drafted this protocol from a study description. Review every stage before fielding.\n\n**Study.** First-year university students map the friendships they have formed during their first semester. The study links the drinking of a student's friends to the student's own drinking (AUDIT-C) and wellbeing (WHO-5).\n\n**Design rationale.** One person node type keeps everyone on a single map. A quick-add name generator capped at 20 people keeps the network small enough for a sociogram, which collects \"know each other\" ties and drinking companions in one place. Bins collect closeness, how people met and perceived heavy drinking with little burden. The validated AUDIT-C and WHO-5 items come after the network task, and the drinking-amount items are skipped for non-drinkers.\n\n**Validated instruments.** Check the wording and scoring of audit_frequency, audit_typical, audit_heavy, who5_cheerful, who5_calm, who5_active, who5_rested, who5_interest against the published instrument; Sketch reproduces them from memory."
        }
      ]
    },
    {
      "id": "welcome",
      "type": "Information",
      "label": "Welcome",
      "title": "Welcome to the study",
      "items": [
        {
          "id": "text",
          "type": "text",
          "content": "Thank you for taking part. We will ask about the people you have got to know since starting university, about drinking, and about how you have been feeling."
        }
      ]
    },
    {
      "id": "consent",
      "type": "EgoForm",
      "label": "Consent",
      "introductionPanel": {
        "title": "Taking part",
        "text": "This study asks about the friends you have made since starting university, about drinking alcohol, and about how you have been feeling. It takes about 20 minutes. Your answers are confidential, and you can stop at any time."
      },
      "form": {
        "fields": [
          {
            "variable": "ego_consent",
            "prompt": "Do you agree to take part in this study?"
          }
        ]
      }
    },
    {
      "id": "about_you",
      "type": "EgoForm",
      "label": "About you",
      "introductionPanel": {
        "title": "A little about you",
        "text": "First, a few questions about yourself."
      },
      "form": {
        "fields": [
          {
            "variable": "ego_age",
            "prompt": "What is your age in years?"
          },
          {
            "variable": "ego_gender",
            "prompt": "How do you describe your gender?"
          },
          {
            "variable": "ego_lives_in_halls",
            "prompt": "Do you live in university accommodation (halls)?"
          }
        ]
      },
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_1",
              "type": "ego",
              "options": {
                "attribute": "ego_consent",
                "operator": "EXACTLY",
                "value": false
              }
            }
          ]
        },
        "destination": {
          "type": "finish"
        }
      }
    },
    {
      "id": "name_friends",
      "type": "NameGeneratorQuickAdd",
      "label": "Naming friends",
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "p1",
          "text": "Since **starting university this semester**, who have you **become friends with**?",
          "additionalAttributes": [
            {
              "variable": "person_new_friend",
              "value": true
            }
          ]
        },
        {
          "id": "p2",
          "text": "Who do you **spend most of your free time with** at university?"
        },
        {
          "id": "p3",
          "text": "Who would you **turn to for support** if something was worrying you?",
          "additionalAttributes": [
            {
              "variable": "person_support",
              "value": true
            }
          ]
        }
      ],
      "behaviours": {
        "maxNodes": 20
      },
      "quickAdd": "person_name",
      "panels": [
        {
          "id": "existing",
          "title": "Already mentioned",
          "dataSource": "existing"
        }
      ]
    },
    {
      "id": "friend_details",
      "type": "AlterForm",
      "label": "Friend details",
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_2",
              "type": "node",
              "options": {
                "type": "person",
                "operator": "NOT_EXISTS"
              }
            }
          ]
        }
      },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "introductionPanel": {
        "title": "About the people you named",
        "text": "Next, two quick questions about each person."
      },
      "form": {
        "fields": [
          {
            "variable": "person_is_first_year",
            "prompt": "Is this person also a first-year student?"
          },
          {
            "variable": "person_first_met",
            "prompt": "When did you first meet this person?"
          }
        ]
      }
    },
    {
      "id": "friend_bins",
      "type": "OrdinalBin",
      "label": "Closeness, meeting, drinking",
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_3",
              "type": "node",
              "options": {
                "type": "person",
                "operator": "NOT_EXISTS"
              }
            }
          ]
        }
      },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "p1",
          "text": "Drag each person into the box that best describes **how close you feel** to them.",
          "variable": "person_closeness",
          "color": "ord-color-seq-1"
        }
      ]
    },
    {
      "id": "friend_bins_2",
      "type": "CategoricalBin",
      "label": "Closeness, meeting, drinking (2)",
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_4",
              "type": "node",
              "options": {
                "type": "person",
                "operator": "NOT_EXISTS"
              }
            }
          ]
        }
      },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "p1",
          "text": "How did you **first meet** each person?",
          "variable": "person_how_met",
          "otherVariable": "person_how_met_other",
          "otherVariablePrompt": "Please describe",
          "otherOptionLabel": "Other"
        },
        {
          "id": "p2",
          "text": "As far as you know, does each person often **drink heavily** (five or more drinks on one occasion)?",
          "variable": "person_drinks_heavily"
        }
      ]
    },
    {
      "id": "friend_map",
      "type": "Sociogram",
      "label": "Friendship map",
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_5",
              "type": "node",
              "options": {
                "type": "person",
                "operator": "NOT_EXISTS"
              }
            }
          ]
        }
      },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "background": {
        "concentricCircles": 4,
        "skewedTowardCenter": true
      },
      "behaviours": {
        "automaticLayout": false
      },
      "prompts": [
        {
          "id": "p1",
          "text": "Place the people you are **closest to** nearest the centre.",
          "layout": {
            "layoutVariable": "person_layout"
          }
        },
        {
          "id": "p2",
          "text": "Draw a line between any two people who **know each other**.",
          "layout": {
            "layoutVariable": "person_layout"
          },
          "edges": {
            "create": "knows",
            "display": ["knows"]
          }
        },
        {
          "id": "p3",
          "text": "Tap everyone you **usually drink alcohol with**.",
          "layout": {
            "layoutVariable": "person_layout"
          },
          "edges": {
            "display": ["knows"]
          },
          "highlight": {
            "allowHighlighting": true,
            "variable": "person_drinks_with"
          }
        }
      ]
    },
    {
      "id": "drinking_together",
      "type": "OrdinalBin",
      "label": "Drinking together",
      "skipLogic": {
        "action": "SHOW",
        "filter": {
          "rules": [
            {
              "id": "rule_6",
              "type": "node",
              "options": {
                "type": "person",
                "attribute": "person_drinks_with",
                "operator": "EXACTLY",
                "value": true
              }
            }
          ]
        }
      },
      "subject": {
        "entity": "node",
        "type": "person"
      },
      "prompts": [
        {
          "id": "p1",
          "text": "How often do you **drink alcohol together** with each person?",
          "variable": "person_drink_together_freq",
          "color": "ord-color-seq-2"
        }
      ],
      "filter": {
        "rules": [
          {
            "id": "rule_7",
            "type": "node",
            "options": {
              "type": "person",
              "attribute": "person_drinks_with",
              "operator": "EXACTLY",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "your_drinking",
      "type": "EgoForm",
      "label": "Your drinking",
      "introductionPanel": {
        "title": "Your drinking",
        "text": "These questions are about your own drinking."
      },
      "form": {
        "fields": [
          {
            "variable": "ego_audit_frequency",
            "prompt": "How often do you have a drink containing alcohol?"
          }
        ]
      }
    },
    {
      "id": "drinking_amount",
      "type": "EgoForm",
      "label": "Drinking amount",
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_8",
              "type": "ego",
              "options": {
                "attribute": "ego_audit_frequency",
                "operator": "EXACTLY",
                "value": 0
              }
            }
          ]
        }
      },
      "introductionPanel": {
        "title": "Your drinking",
        "text": "A little more about how much you drink."
      },
      "form": {
        "fields": [
          {
            "variable": "ego_audit_typical",
            "prompt": "How many drinks containing alcohol do you have on a typical day when you are drinking?"
