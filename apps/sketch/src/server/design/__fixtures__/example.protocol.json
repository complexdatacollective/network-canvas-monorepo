          {
            "variable": "ego_audit_heavy",
            "prompt": "How often do you have six or more drinks on one occasion?"
          }
        ]
      }
    },
    {
      "id": "wellbeing",
      "type": "EgoForm",
      "label": "Wellbeing (WHO-5)",
      "introductionPanel": {
        "title": "How you have been feeling",
        "text": "Please think about the last two weeks."
      },
      "form": {
        "fields": [
          {
            "variable": "ego_who5_cheerful",
            "prompt": "Over the last two weeks: I have felt cheerful and in good spirits."
          },
          {
            "variable": "ego_who5_calm",
            "prompt": "Over the last two weeks: I have felt calm and relaxed."
          },
          {
            "variable": "ego_who5_active",
            "prompt": "Over the last two weeks: I have felt active and vigorous."
          },
          {
            "variable": "ego_who5_rested",
            "prompt": "Over the last two weeks: I woke up feeling fresh and rested."
          },
          {
            "variable": "ego_who5_interest",
            "prompt": "Over the last two weeks: My daily life has been filled with things that interest me."
          }
        ]
      }
    },
    {
      "id": "review",
      "type": "Narrative",
      "label": "Talking about your map",
      "skipLogic": {
        "action": "SKIP",
        "filter": {
          "rules": [
            {
              "id": "rule_9",
              "type": "node",
              "options": {
