{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": { "type": true },
  // Claude skill entries are symlinks to the canonical .agents files. Ignore
  // the mirrored tree so Knip does not analyse every script twice.
  "ignore": [".claude/skills/**"],
  // The legacy app-build workflow (.github/workflows/legacy-app-build.yml)
  // invokes the electron-builder binary, which is a devDependency of the
  // legacy architect app rather than the root, so knip sees it as unlisted.
  // xcrun is the macOS simulator tool used by the Capacitor dev helper.
  // taskkill is the Windows process-termination tool used by
  // apps/architect-classic/scripts/dev.mjs to tear down dev-server processes.
  // diff is the POSIX tool apps/fresco/release-test/scripts/diff-exports.mjs
  // spawns to compare normalized export trees.
  "ignoreBinaries": ["electron-builder", "xcrun", "taskkill", "diff"],
  // unplugin-dts loads @typescript/typescript6 by name at build time (TypeScript
  // 7 dropped the JavaScript Compiler API it needs for declaration emit), so it
  // is never imported from source.
  "ignoreDependencies": ["@typescript/typescript6"],
  "tags": ["-public"],
  "workspaces": {
    // The release-test walkers are invoked with node by the
    // interviewer-release-test workflow's journey agents (prompt text knip
    // cannot parse), so they must be declared as entries. They deliberately
    // resolve @playwright/test out of apps/interviewer's dependency tree via
    // createRequire rather than adding a root dependency.
    ".": {
      "entry": [
        "scripts/interviewer-*-walker.mjs",
        // Invoked by the CI workflow through POSTHOG_CLI_BINARY_PATH.
        "scripts/posthog-cli-upload-stub.mjs"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "jszip",
        // Resolved by @posthog/plugin-utils and spawned by path at build time.
        "@posthog/cli"
      ]
    },
    "apps/networkcanvas.com": {
      "entry": ["lib/i18n/request.ts", "netlify/edge-functions/locale.ts"]
    },
    "apps/documentation": {
      "ignore": ["lib/i18n/request.ts", "next-sitemap.config.js"]
    },
    // Ported from apps/fresco/knip.config.ts, which knip does not read in
    // monorepo mode. That file (and fresco's .github tooling) still ships to the
    // standalone Fresco repo on mirror, so it is ignored rather than deleted.
    "apps/fresco": {
      // release-test/scripts are invoked from shell scripts knip cannot parse;
      // list them as entries so they and their imports (e.g.
      // scripts/resolve-manifest.mjs in the root workspace) count as used. The
      // project glob deliberately keeps other .mjs invisible, as before.
      "entry": ["release-test/scripts/*.mjs"],
      "project": ["**/*.{js,jsx,ts,tsx}", "release-test/scripts/*.mjs"],
      "ignore": ["knip.config.ts"],
      "ignoreDependencies": [
        "sharp", // Used by next/image but not directly imported
        "@tailwindcss/forms", // Used in globals.css but not detected as used
        "tailwindcss-animate", // Used in globals.css but not detected as used
        "@prisma/client" // Used at runtime by the Prisma generated client
      ],
      "ignoreIssues": {
        // Server actions for passkey password management — UI not yet wired
        "actions/webauthn.ts": ["exports"],
        // Pre-existing unused type exports
        "lib/protocol/validateAndMigrateProtocol.ts": ["types"]
      }
    },
    "packages/interview": {
      "entry": [
        "src/**/*.stories.tsx",
        "e2e/specs/**/*.ts",
        "e2e/host/src/main.tsx",
        "e2e/host/vite.config.ts",
        "e2e/scripts/*.ts",
        "e2e/helpers/assetServer.ts",
        "e2e/fixtures/window-test.d.ts",
        // Resolved by vite.config.ts's inlineWorkerPlugin for the library
        // build, never by an import — see createAutoLayoutWorker.ts.
        "src/canvas/createAutoLayoutWorker.inline.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,js}",
        ".storybook/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}"
      ],
      "paths": {
        "~/*": ["./*"]
      }
    },
    "packages/fresco-ui": {
      // Resolved by vite.config.ts's inlineWorkerPlugin for the library build,
      // never by an import — see createSearchWorker.ts.
      "entry": ["src/collection/filtering/createSearchWorker.inline.ts"]
    },
    "packages/protocol-validation": {},
    "packages/network-exporters": {},
    "packages/interface-images": {},
    "packages/site-navigation-element": {
      "entry": ["src/styles/shadow.css"],
      "ignoreDependencies": [
        "@fontsource-variable/inclusive-sans",
        "@fontsource-variable/nunito",
        "@tailwindcss/cli"
      ]
    },
    "tooling/tailwind": {
      "entry": [
        "shared/plugins/elevation/index.ts",
        "shared/plugins/elevation/elevation.ts",
        "shared/plugins/elevation/jwc.ts",
        "shared/plugins/elevation/utils.ts",
        "shared/plugins/inset-surface/index.ts",
        "shared/plugins/inset-surface/inset-surface.ts",
        "shared/plugins/motion-spring.ts"
      ],
      "project": ["shared/**/*.ts"],
      "ignoreDependencies": [
        "@fontsource-variable/inclusive-sans",
        "@fontsource-variable/nunito"
      ]
    },
    "tooling/vitest": {
      // The legacy setup deliberately resolves the active Classic workspace's
      // Framer Motion installation rather than declaring a second copy here.
      // Consumer coverage is enforced by vitest-animation-setup.test.mjs.
      "ignoreDependencies": ["framer-motion"],
      // Sibling declarations for the untyped setup-path.js entries; TypeScript
      // resolves them implicitly (required for the mirrored app trees, where
      // the vendored copy sits under node_modules), so nothing imports them.
      "ignore": ["legacy/setup-path.d.ts", "modern/setup-path.d.ts"]
    },
    "apps/interviewer-classic": {
      "project": ["src/**/*.{js,jsx}"],
      "paths": { "@/*": ["./src/*"] },
      "ignore": [
        "src/shims/react-resize-aware.js" // wired via electron.vite.config resolve.alias, not a normal import
      ],
      "ignoreDependencies": [
        "buffer", // npm Buffer polyfill — `import { Buffer } from 'buffer'` in filesystem.js + saveExport.js; knip treats 'buffer' as a Node built-in
        "is-hotkey" // required by @codaco/ui's bundled RichText field; @codaco/ui does not declare it
      ]
    },
    "apps/architect-classic": {
      "entry": ["electron-builder.config.js"],
      "project": ["src/**/*.{js,jsx}"],
      "ignoreDependencies": [
        "react-resizable", // CSS only — @import in main.scss, invisible to knip
        "tippy.js", // CSS only — @import in main.scss, peer dep of @tippyjs/react
        // The preview window renders this app: createPreviewWindow.js resolves it
        // via require.resolve('@codaco/interviewer-classic/package.json') and
        // electron-builder.config.js bundles its out/ — neither a static import.
        "@codaco/interviewer-classic",
        // Used only by the CJS public/ Electron main process, which is excluded
        // from `project` above: knip's CJS export --fix corrupts module.exports
        // in the main-process modules, so that tree is left out of analysis.
        "archiver",
        "decompress",
        "electron-log",
        "electron-devtools-installer"
      ],
      "paths": {
        "@app/*": ["./src/*"],
        "@components/*": ["./src/components/*"],
        "@selectors/*": ["./src/selectors/*"],
        "@hooks/*": ["./src/hooks/*"],
        "@modules/*": ["./src/ducks/modules/*"],
        "@utils/*": ["./src/utils/*"]
      }
    },
    "apps/studio/client": {
      "entry": ["index.html!"],
      "vite": true,
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/studio/server": {
      "entry": [
        "scripts/auth-cli-config.ts!",
        // Resolved by vite.netlify.config.ts as a build input string, never
        // by an import — it is the Netlify Function entry.
        "src/netlify.ts!"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      // Resolved with import.meta.resolve, so the specifier is a runtime string
      // knip cannot follow.
      "ignoreDependencies": ["@codaco/protocols"]
    },
    "apps/interviewer": {
      "entry": [
        "index.html!",
        "vite.renderer.config.ts",
        "e2e/specs/**/*.ts",
        "e2e/scripts/*.{ts,mjs}"
      ],
      "vite": true,
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,tsx}"],
      "paths": {
        "~/*": ["./src/*"]
      }
    },
    "apps/architect": {
      "entry": [
        "index.html!",
        "preview/index.html!",
        "src/preview-main.tsx!",
        "e2e/specs/**/*.ts"
      ],
      "vite": true,
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,tsx}"],
      "paths": {
        "~/*": ["./src/*"]
      },
      "ignoreDependencies": ["@types/recompose"],
      "ignore": ["src/**/*.d.ts"]
    },
    "apps/background-creator": {
      "entry": ["index.html!"],
      "vite": true,
      "project": ["src/**/*.{ts,tsx}"],
      "paths": {
        "~/*": ["./src/*"]
      },
      "ignoreBinaries": ["Rscript"]
    },
    "workers/development-protocol": {},
    "workers/posthog-proxy": {}
  }
}
