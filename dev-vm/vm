#!/usr/bin/env bash
# Host-side driver for the Network Canvas dev VM. See dev-vm/README.md.
#
#   dev-vm/vm up            create the data disk (first time) and start the VM
#   dev-vm/vm bootstrap     clone the repo, install toolchain + deps (idempotent)
#   dev-vm/vm shell [cmd]   shell into the VM (same directory when it exists there)
#   dev-vm/vm sync-claude   copy Claude Code settings, skills and project memory in
#   dev-vm/vm stop          stop the VM
#   dev-vm/vm status        show the instance and data disk
#   dev-vm/vm rebuild       recreate the OS disk from lima.yaml; keeps the data disk
#   dev-vm/vm destroy       delete the instance AND the data disk
set -eu -o pipefail

NAME="${DEV_VM_NAME:-nc}"
DISK="nc-data"
DISK_SIZE="${DEV_VM_DISK_SIZE:-400GiB}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
LIMA_HOME="${LIMA_HOME:-$HOME/.lima}"

die() {
  printf 'dev-vm: %s\n' "$*" >&2
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required (brew install $2)"; }

instance_exists() { limactl list --format '{{.Name}}' 2>/dev/null | grep -qx "$NAME"; }
disk_exists() { limactl disk list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qx "$DISK"; }

exclude_from_backups() {
  # The disk images are large, change constantly and are reproducible or
  # git-backed; keep Time Machine away from them.
  local path
  for path in "$LIMA_HOME/$NAME" "$LIMA_HOME/_disks/$DISK"; do
    [ -e "$path" ] && tmutil addexclusion "$path" >/dev/null 2>&1 || true
  done
}

cmd_up() {
  need limactl lima
  if ! disk_exists; then
    printf 'Creating %s data disk %s (sparse; grows with use)\n' "$DISK_SIZE" "$DISK"
    limactl disk create "$DISK" --size "$DISK_SIZE" --format raw
  fi
  if instance_exists; then
    limactl start "$NAME"
  else
    limactl start --name "$NAME" --tty=false "$HERE/lima.yaml"
  fi
  exclude_from_backups
  printf '\nVM is up. Next: dev-vm/vm bootstrap (first time), then dev-vm/vm shell\n'
}

cmd_bootstrap() {
  instance_exists || die "no instance '$NAME' — run dev-vm/vm up first"
  local remote name email
  remote="$(git -C "$REPO_ROOT" remote get-url origin)"
  name="$(git -C "$REPO_ROOT" config user.name || true)"
  email="$(git -C "$REPO_ROOT" config user.email || true)"

  if command -v gh >/dev/null 2>&1 && gh auth token >/dev/null 2>&1 \
    && ! limactl shell "$NAME" gh auth status >/dev/null 2>&1; then
    printf 'Signing the guest gh in with the host token\n'
    gh auth token | limactl shell "$NAME" bash -c 'gh auth login --with-token && gh auth setup-git'
  fi

  limactl shell "$NAME" bash -s -- "$remote" "$REPO_ROOT" "$name" "$email" < "$HERE/bootstrap.sh"
}

cmd_sync_claude() {
  instance_exists || die "no instance '$NAME' — run dev-vm/vm up first"
  local src="$HOME/.claude"
  local slug
  slug="$(printf '%s' "$REPO_ROOT" | sed 's#[/.]#-#g')"
  limactl shell "$NAME" install -d "$src/projects/$slug" "$src/skills"
  local item
  for item in settings.json CLAUDE.md skills agents hooks "projects/$slug/memory"; do
    if [ -e "$src/$item" ]; then
      limactl copy -r "$src/$item" "$NAME:$src/$(dirname "$item")/"
    fi
  done
  printf 'Synced Claude Code settings, skills and project memory into the VM.\n'
}

cmd_shell() {
  instance_exists || die "no instance '$NAME' — run dev-vm/vm up first"
  exec limactl shell "$NAME" "$@"
}

cmd_stop() { limactl stop "$NAME"; }

cmd_status() {
  limactl list "$NAME" 2>/dev/null || printf 'no instance %s\n' "$NAME"
  limactl disk list 2>/dev/null | grep -E "^(NAME|$DISK)" || true
}

cmd_rebuild() {
  if instance_exists; then
    printf 'Deleting instance %s (the %s disk is kept)\n' "$NAME" "$DISK"
    limactl delete --force "$NAME"
  fi
  cmd_up
}

cmd_destroy() {
  printf 'This deletes the VM and the %s disk, including every repository and credential on it.\n' "$DISK"
  read -r -p 'Type the disk name to confirm: ' answer
  [ "$answer" = "$DISK" ] || die 'aborted'
  instance_exists && limactl delete --force "$NAME"
  disk_exists && limactl disk delete "$DISK"
  printf 'Destroyed.\n'
}

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  shell | ssh) shift; cmd_shell "$@" ;;
  sync-claude) shift; cmd_sync_claude "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  status) shift; cmd_status "$@" ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  destroy) shift; cmd_destroy "$@" ;;
  *) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 64 ;;
esac
